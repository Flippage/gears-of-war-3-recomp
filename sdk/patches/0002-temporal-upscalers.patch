diff --git a/src/graphics/d3d12/gow2_dlss.cpp b/src/graphics/d3d12/gow2_dlss.cpp
new file mode 100644
index 0000000..0fecf91
--- /dev/null
+++ b/src/graphics/d3d12/gow2_dlss.cpp
@@ -0,0 +1,202 @@
+// Adapted from gears-judgement-recomp (BSD-3-Clause).
+// NVIDIA DLSS (NGX) wrapper for the temporal pipeline. Nothing from NVIDIA is redistributed here:
+// nvngx_dlss.dll is loaded at run time from the game folder when it is present.
+#include <rex/graphics/d3d12/gow2_dlss.h>
+
+#include <filesystem>
+
+#include <rex/logging.h>
+
+#ifdef GOW2_HAS_DLSS
+#include <nvsdk_ngx.h>
+#include <nvsdk_ngx_defs.h>
+#include <nvsdk_ngx_helpers.h>
+#include <nvsdk_ngx_helpers_d3d.h>
+#include <nvsdk_ngx_params.h>
+#endif
+
+namespace rex::graphics::d3d12::gow2 {
+
+#ifdef GOW2_HAS_DLSS
+namespace {
+ID3D12Device* g_device = nullptr;
+NVSDK_NGX_Parameter* g_caps = nullptr;
+NVSDK_NGX_Parameter* g_params = nullptr;
+NVSDK_NGX_Handle* g_feature = nullptr;
+bool g_init_tried = false;
+bool g_ok = false;
+uint32_t g_in_w, g_in_h, g_out_w, g_out_h;
+int g_quality = -1;
+}  // namespace
+
+static void NgxLog(const char* msg, NVSDK_NGX_Logging_Level, NVSDK_NGX_Feature) {
+  REXGPU_WARN("NGX: {}", msg);
+}
+
+bool DlssInit(ID3D12Device* device) {
+  if (g_init_tried) return g_ok;
+  g_init_tried = true;
+  g_device = device;
+  std::filesystem::path dir = std::filesystem::current_path();
+  std::wstring dllpath = dir.wstring();
+  // The single-file release unpacks the game elsewhere; the vendor DLLs sit in the folder the player
+  // started it from (GOW2_HOME), which is searched first.
+  std::wstring home;
+  {
+    wchar_t b[1024];
+    const DWORD n = GetEnvironmentVariableW(L"GOW2_HOME", b, 1024);
+    if (n && n < 1024) home = b;
+  }
+  if (!home.empty()) SetDllDirectoryW(home.c_str());
+  const wchar_t* paths[2] = {home.empty() ? dllpath.c_str() : home.c_str(), dllpath.c_str()};
+  NVSDK_NGX_FeatureCommonInfo info = {};
+  info.PathListInfo.Path = paths;
+  info.PathListInfo.Length = home.empty() ? 1 : 2;
+  info.LoggingInfo.LoggingCallback = &NgxLog;
+  info.LoggingInfo.MinimumLoggingLevel = NVSDK_NGX_LOGGING_LEVEL_ON;
+  info.LoggingInfo.DisableOtherLoggingSinks = false;
+  std::wstring data = (dir / L"gow2_ngx").wstring();
+  std::filesystem::create_directories(dir / L"gow2_ngx");
+  NVSDK_NGX_Result r = NVSDK_NGX_D3D12_Init_with_ProjectID(
+      "b742a0d0-b3f9-4ebd-baa6-c3066954b994", NVSDK_NGX_ENGINE_TYPE_CUSTOM, "1.0", data.c_str(),
+      device, &info);
+  if (NVSDK_NGX_FAILED(r)) {
+    REXGPU_WARN("DLSS: NGX init failed 0x{:08X}", uint32_t(r));
+    return false;
+  }
+  r = NVSDK_NGX_D3D12_GetCapabilityParameters(&g_caps);
+  if (NVSDK_NGX_FAILED(r)) {
+    REXGPU_WARN("DLSS: capability parameters failed 0x{:08X}", uint32_t(r));
+    return false;
+  }
+  int available = 0;
+  NVSDK_NGX_Parameter_GetI(g_caps, NVSDK_NGX_Parameter_SuperSampling_Available, &available);
+  if (!available) {
+    int need_update = 0;
+    NVSDK_NGX_Parameter_GetI(g_caps, NVSDK_NGX_Parameter_SuperSampling_NeedsUpdatedDriver,
+                             &need_update);
+    REXGPU_WARN("DLSS: super sampling unavailable (needs updated driver: {})", need_update);
+    return false;
+  }
+  {
+    // Diagnostics: can this device create the kind of shared textures NGX needs?
+    D3D12_HEAP_PROPERTIES hp = {};
+    hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC d = {};
+    d.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    d.Width = 256;
+    d.Height = 256;
+    d.DepthOrArraySize = 1;
+    d.MipLevels = 1;
+    d.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+    d.SampleDesc.Count = 1;
+    struct Variant {
+      D3D12_HEAP_FLAGS hf;
+      D3D12_RESOURCE_FLAGS rf;
+      const char* name;
+    } variants[] = {
+        {D3D12_HEAP_FLAG_NONE, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, "uav"},
+        {D3D12_HEAP_FLAG_SHARED, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, "shared+uav"},
+        {D3D12_HEAP_FLAG_SHARED,
+         D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS | D3D12_RESOURCE_FLAG_ALLOW_SIMULTANEOUS_ACCESS,
+         "shared+uav+simultaneous"},
+    };
+    for (auto& v : variants) {
+      d.Flags = v.rf;
+      ID3D12Resource* res = nullptr;
+      HRESULT hr = device->CreateCommittedResource(&hp, v.hf, &d, D3D12_RESOURCE_STATE_COMMON,
+                                                   nullptr, IID_PPV_ARGS(&res));
+      REXGPU_WARN("DLSS diag: CreateCommittedResource {} -> 0x{:08X}", v.name, uint32_t(hr));
+      if (res) res->Release();
+    }
+    D3D12_FEATURE_DATA_D3D12_OPTIONS opt = {};
+    device->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS, &opt, sizeof opt);
+    REXGPU_WARN("DLSS diag: ResourceHeapTier {} ResourceBindingTier {}", int(opt.ResourceHeapTier),
+                int(opt.ResourceBindingTier));
+  }
+  r = NVSDK_NGX_D3D12_AllocateParameters(&g_params);
+  if (NVSDK_NGX_FAILED(r)) return false;
+  g_ok = true;
+  REXGPU_WARN("DLSS: NGX initialised, super sampling available");
+  return true;
+}
+
+bool DlssEvaluate(ID3D12GraphicsCommandList* list, const DlssEval& e) {
+  if (!g_ok) return false;
+  if (!g_feature || g_in_w != e.render_w || g_in_h != e.render_h || g_out_w != e.out_w ||
+      g_out_h != e.out_h || g_quality != e.quality) {
+    if (g_feature) {
+      NVSDK_NGX_D3D12_ReleaseFeature(g_feature);
+      g_feature = nullptr;
+    }
+    NVSDK_NGX_DLSS_Create_Params cp = {};
+    cp.Feature.InWidth = e.render_w;
+    cp.Feature.InHeight = e.render_h;
+    cp.Feature.InTargetWidth = e.out_w;
+    cp.Feature.InTargetHeight = e.out_h;
+    cp.Feature.InPerfQualityValue = NVSDK_NGX_PerfQuality_Value(e.quality);
+    cp.InFeatureCreateFlags = NVSDK_NGX_DLSS_Feature_Flags_MVLowRes |
+                              NVSDK_NGX_DLSS_Feature_Flags_DepthInverted |
+                              NVSDK_NGX_DLSS_Feature_Flags_AutoExposure;
+    if (e.hdr) cp.InFeatureCreateFlags |= NVSDK_NGX_DLSS_Feature_Flags_IsHDR;
+    NVSDK_NGX_Result r = NGX_D3D12_CREATE_DLSS_EXT(list, 1, 1, &g_feature, g_params, &cp);
+    if (NVSDK_NGX_FAILED(r)) {
+      REXGPU_WARN("DLSS: feature creation failed 0x{:08X} ({}x{} -> {}x{} q{})", uint32_t(r),
+                  e.render_w, e.render_h, e.out_w, e.out_h, e.quality);
+      g_feature = nullptr;
+      return false;
+    }
+    g_in_w = e.render_w;
+    g_in_h = e.render_h;
+    g_out_w = e.out_w;
+    g_out_h = e.out_h;
+    g_quality = e.quality;
+    REXGPU_WARN("DLSS: feature created {}x{} -> {}x{} quality {}", e.render_w, e.render_h, e.out_w,
+                e.out_h, e.quality);
+  }
+  NVSDK_NGX_D3D12_DLSS_Eval_Params ep = {};
+  ep.Feature.pInColor = e.color;
+  ep.Feature.pInOutput = e.output;
+  ep.Feature.InSharpness = 0.0f;
+  ep.pInDepth = e.depth;
+  ep.pInMotionVectors = e.motion;
+  ep.InJitterOffsetX = e.jitter_x;
+  ep.InJitterOffsetY = e.jitter_y;
+  ep.InRenderSubrectDimensions.Width = e.render_w;
+  ep.InRenderSubrectDimensions.Height = e.render_h;
+  ep.InReset = e.reset ? 1 : 0;
+  ep.InMVScaleX = 1.0f;
+  ep.InMVScaleY = 1.0f;
+  ep.InPreExposure = 1.0f;
+  ep.InExposureScale = 1.0f;
+  ep.InFrameTimeDeltaInMsec = e.frame_ms;
+  NVSDK_NGX_Result r = NGX_D3D12_EVALUATE_DLSS_EXT(list, g_feature, g_params, &ep);
+  if (NVSDK_NGX_FAILED(r)) {
+    REXGPU_WARN("DLSS: evaluate failed 0x{:08X}", uint32_t(r));
+    return false;
+  }
+  return true;
+}
+
+void DlssShutdown() {
+  if (g_feature) NVSDK_NGX_D3D12_ReleaseFeature(g_feature);
+  g_feature = nullptr;
+  if (g_params) NVSDK_NGX_D3D12_DestroyParameters(g_params);
+  g_params = nullptr;
+  if (g_device) NVSDK_NGX_D3D12_Shutdown1(g_device);
+  g_device = nullptr;
+  g_ok = false;
+}
+
+bool DlssCompiledIn() { return true; }
+
+#else  // !GOW2_HAS_DLSS
+
+bool DlssInit(ID3D12Device*) { return false; }
+bool DlssEvaluate(ID3D12GraphicsCommandList*, const DlssEval&) { return false; }
+void DlssShutdown() {}
+bool DlssCompiledIn() { return false; }
+
+#endif
+
+}  // namespace rex::graphics::d3d12::gow2
diff --git a/src/graphics/d3d12/gow2_fsr.cpp b/src/graphics/d3d12/gow2_fsr.cpp
new file mode 100644
index 0000000..5bbb6b3
--- /dev/null
+++ b/src/graphics/d3d12/gow2_fsr.cpp
@@ -0,0 +1,237 @@
+// Adapted from gears-judgement-recomp (BSD-3-Clause).
+// AMD FidelityFX Super Resolution backend for the temporal pipeline. Nothing from AMD is
+// redistributed: amd_fidelityfx_loader_dx12.dll (and the upscaler provider next to it) are loaded
+// from the game folder when present.
+#include <rex/graphics/d3d12/gow2_fsr.h>
+
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include <rex/logging.h>
+
+#ifdef GOW2_HAS_FFX
+#define _WINDOWS 1
+#include <ffx_api.h>
+#include <ffx_api_loader.h>
+#include <ffx_api_types.h>
+#include <dx12/ffx_api_dx12.h>
+#include <ffx_upscale.h>
+#endif
+
+namespace rex::graphics::d3d12::gow2 {
+
+#ifdef GOW2_HAS_FFX
+namespace {
+ID3D12Device* g_device = nullptr;
+HMODULE g_module = nullptr;
+ffxFunctions g_fn = {};
+bool g_tried = false, g_ok = false;
+ffxContext g_ctx = nullptr;
+uint32_t g_rw, g_rh, g_ow, g_oh;
+int g_major = -1;
+std::string g_provider;
+bool g_fsr4 = false;
+struct Version {
+  uint64_t id;
+  std::string name;
+};
+std::vector<Version> g_versions;
+
+void FsrMessage(uint32_t type, const wchar_t* msg) {
+  char buf[512];
+  size_t n = 0;
+  wcstombs_s(&n, buf, sizeof buf, msg, _TRUNCATE);
+  REXGPU_WARN("FFX{}: {}", type, buf);
+}
+
+// Creation chain: upscale desc -> DX12 backend desc (-> version override).
+struct Chain {
+  ffxCreateContextDescUpscale up{};
+  ffxCreateBackendDX12Desc be{};
+  ffxOverrideVersion ov{};
+};
+
+// Provider names are bare versions such as "4.1.1"; older loaders prefix them ("FSR 3.1.5").
+int VersionMajor(const std::string& name) {
+  size_t i = 0;
+  while (i < name.size() && (name[i] < '0' || name[i] > '9')) ++i;
+  if (i == name.size()) return -1;
+  int major = 0;
+  while (i < name.size() && name[i] >= '0' && name[i] <= '9') {
+    major = major * 10 + (name[i] - '0');
+    ++i;
+  }
+  return major;
+}
+}  // namespace
+
+bool FsrInit(ID3D12Device* device) {
+  if (g_tried) return g_ok;
+  g_tried = true;
+  g_device = device;
+  // Look in the folder the player started the game from first (the single-file release unpacks the
+  // game elsewhere), then in the default search path.
+  {
+    wchar_t b[1024];
+    const DWORD n = GetEnvironmentVariableW(L"GOW2_HOME", b, 1024);
+    if (n && n < 1024) {
+      SetDllDirectoryW(b);  // the loader finds the upscaler DLL there too
+      g_module = LoadLibraryExW((std::wstring(b) + L"\\amd_fidelityfx_loader_dx12.dll").c_str(), nullptr,
+                                LOAD_WITH_ALTERED_SEARCH_PATH);
+    }
+  }
+  if (!g_module) g_module = LoadLibraryW(L"amd_fidelityfx_loader_dx12.dll");
+  if (!g_module) {
+    REXGPU_WARN("FSR: amd_fidelityfx_loader_dx12.dll not found next to the game");
+    return false;
+  }
+  ffxLoadFunctions(&g_fn, g_module);
+  if (!g_fn.CreateContext || !g_fn.Dispatch || !g_fn.Query || !g_fn.DestroyContext) {
+    REXGPU_WARN("FSR: loader exports are missing");
+    return false;
+  }
+  // Enumerate the upscaler providers this machine can use.
+  uint64_t count = 0;
+  ffxQueryDescGetVersions q{};
+  q.header.type = FFX_API_QUERY_DESC_TYPE_GET_VERSIONS;
+  q.createDescType = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE;
+  q.device = device;
+  q.outputCount = &count;
+  if (g_fn.Query(nullptr, &q.header) == FFX_API_RETURN_OK && count) {
+    std::vector<uint64_t> ids(count);
+    std::vector<const char*> names(count);
+    q.versionIds = ids.data();
+    q.versionNames = names.data();
+    uint64_t cap = count;
+    q.outputCount = &cap;
+    if (g_fn.Query(nullptr, &q.header) == FFX_API_RETURN_OK) {
+      for (uint64_t i = 0; i < cap; ++i) {
+        g_versions.push_back({ids[i], names[i] ? names[i] : ""});
+        REXGPU_WARN("FSR provider {}: id=0x{:X} '{}'", i, ids[i], names[i] ? names[i] : "?");
+        if (VersionMajor(names[i] ? names[i] : "") == 4) g_fsr4 = true;
+      }
+    }
+  }
+  if (g_versions.empty()) {
+    REXGPU_WARN("FSR: the loader reports no upscaler providers (is the upscaler DLL next to it?)");
+    return false;
+  }
+  g_ok = true;
+  return true;
+}
+
+bool FsrHasFsr4() { return g_fsr4; }
+const char* FsrProviderName() { return g_provider.c_str(); }
+
+static bool CreateCtx(const FsrEval& e) {
+  Chain c;
+  c.up.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE;
+  c.up.flags = FFX_UPSCALE_ENABLE_DEPTH_INVERTED | FFX_UPSCALE_ENABLE_AUTO_EXPOSURE |
+               FFX_UPSCALE_ENABLE_NON_LINEAR_COLORSPACE;
+  if (std::getenv("GOW2_FSR_DEBUG")) c.up.flags |= FFX_UPSCALE_ENABLE_DEBUG_CHECKING;
+  c.up.maxRenderSize = {e.render_w, e.render_h};
+  c.up.maxUpscaleSize = {e.out_w, e.out_h};
+  c.up.fpMessage = &FsrMessage;
+  c.be.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_DX12;
+  c.be.device = g_device;
+  c.up.header.pNext = &c.be.header;
+  // Pick a provider by major version (names look like "4.1.1" or "FSR 3.1.5").
+  uint64_t chosen = 0;
+  for (const Version& v : g_versions) {
+    const int major = VersionMajor(v.name);
+    if (major == e.wanted_major) {
+      chosen = v.id;
+      g_provider = v.name;
+      break;
+    }
+  }
+  if (chosen) {
+    c.ov.header.type = FFX_API_DESC_TYPE_OVERRIDE_VERSION;
+    c.ov.versionId = chosen;
+    c.be.header.pNext = &c.ov.header;
+  } else {
+    g_provider = g_versions.front().name;
+  }
+  ffxReturnCode_t rc = g_fn.CreateContext(&g_ctx, &c.up.header, nullptr);
+  if (rc != FFX_API_RETURN_OK) {
+    REXGPU_WARN("FSR: context creation failed ({}), provider '{}'", uint32_t(rc), g_provider);
+    g_ctx = nullptr;
+    return false;
+  }
+  g_rw = e.render_w;
+  g_rh = e.render_h;
+  g_ow = e.out_w;
+  g_oh = e.out_h;
+  g_major = e.wanted_major;
+  REXGPU_WARN("FSR: context created '{}' render {}x{} -> {}x{}", g_provider, g_rw, g_rh, g_ow, g_oh);
+  return true;
+}
+
+static bool CreateCtxWithFallback(const FsrEval& e) {
+  if (CreateCtx(e)) return true;
+  if (e.wanted_major != 4) return false;
+  REXGPU_WARN("FSR: FSR 4 context failed, falling back to FSR 3.1");
+  g_fsr4 = false;
+  FsrEval fallback = e;
+  fallback.wanted_major = 3;
+  return CreateCtx(fallback);
+}
+
+bool FsrEvaluate(ID3D12GraphicsCommandList* list, const FsrEval& e) {
+  if (!g_ok) return false;
+  if (!g_ctx || g_rw != e.render_w || g_rh != e.render_h || g_ow != e.out_w || g_oh != e.out_h ||
+      g_major != e.wanted_major) {
+    if (g_ctx) {
+      g_fn.DestroyContext(&g_ctx, nullptr);
+      g_ctx = nullptr;
+    }
+    if (!CreateCtxWithFallback(e)) return false;
+  }
+  ffxDispatchDescUpscale d{};
+  d.header.type = FFX_API_DISPATCH_DESC_TYPE_UPSCALE;
+  d.commandList = list;
+  d.color = ffxApiGetResourceDX12(e.color, FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+  d.depth = ffxApiGetResourceDX12(e.depth, FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+  d.motionVectors = ffxApiGetResourceDX12(e.motion, FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+  d.output = ffxApiGetResourceDX12(e.output, FFX_API_RESOURCE_STATE_UNORDERED_ACCESS);
+  d.color.description.format = ffxApiGetSurfaceFormatDX12(e.color_format);
+  d.jitterOffset = {e.jitter_x, e.jitter_y};
+  d.motionVectorScale = {1.0f, 1.0f};
+  d.renderSize = {e.render_w, e.render_h};
+  d.upscaleSize = {e.out_w, e.out_h};
+  d.enableSharpening = false;
+  d.sharpness = 0.0f;
+  d.frameTimeDelta = e.frame_ms;
+  d.preExposure = 1.0f;
+  d.reset = e.reset;
+  d.cameraNear = e.camera_near;
+  d.cameraFar = e.camera_far;
+  d.cameraFovAngleVertical = e.fov_y;
+  d.viewSpaceToMetersFactor = 0.01f;  // Unreal units are centimetres
+  d.flags = 0;
+  ffxReturnCode_t rc = g_fn.Dispatch(&g_ctx, &d.header);
+  if (rc != FFX_API_RETURN_OK) {
+    REXGPU_WARN("FSR: dispatch failed ({})", uint32_t(rc));
+    return false;
+  }
+  return true;
+}
+
+void FsrShutdown() {
+  if (g_ctx && g_fn.DestroyContext) g_fn.DestroyContext(&g_ctx, nullptr);
+  g_ctx = nullptr;
+}
+
+#else  // !GOW2_HAS_FFX
+
+bool FsrInit(ID3D12Device*) { return false; }
+bool FsrHasFsr4() { return false; }
+const char* FsrProviderName() { return ""; }
+bool FsrEvaluate(ID3D12GraphicsCommandList*, const FsrEval&) { return false; }
+void FsrShutdown() {}
+
+#endif
+
+}  // namespace rex::graphics::d3d12::gow2
diff --git a/src/graphics/d3d12/gow2_temporal.cpp b/src/graphics/d3d12/gow2_temporal.cpp
new file mode 100644
index 0000000..0619953
--- /dev/null
+++ b/src/graphics/d3d12/gow2_temporal.cpp
@@ -0,0 +1,371 @@
+// Adapted from gears-judgement-recomp (BSD-3-Clause).
+// Project-local temporal-upscaling support: scene camera capture and frame dumps.
+#include <rex/graphics/d3d12/gow2_temporal.h>
+
+#include <wrl/client.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <string>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <memory>
+#include <vector>
+
+#include <rex/graphics/d3d12/command_processor.h>
+#include <rex/graphics/d3d12/deferred_command_list.h>
+#include <rex/graphics/d3d12/texture_cache.h>
+#include <rex/graphics/register_file.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_BOOL(gow2_temporal, false, "gfx",
+                    "Temporal pipeline: sub-pixel jitter of the scene (foundation for DLSS/FSR)");
+REXCVAR_DEFINE_STRING(gow2_upscale_status, "", "gfx",
+                      "Upscaler status line shown by the FPS overlay (set by the GPU plugin)");
+REXCVAR_DEFINE_DOUBLE(gow2_jitter_scale, 1.0, "gfx",
+                      "Multiplier on the jitter offsets (debug: a large value makes jitter visible)");
+REXCVAR_DEFINE_INT32(gow2_jitter_phases, 8, "gfx", "Length of the Halton jitter sequence");
+REXCVAR_DEFINE_INT32(gow2_vp_register, 0, "gfx",
+                     "First VS float constant holding the scene ViewProjection matrix (4 rows)");
+REXCVAR_DEFINE_INT32(gow2_campos_register, 13, "gfx",
+                     "VS float constant row holding the camera world position");
+
+namespace rex::graphics::d3d12::gow2 {
+
+namespace {
+
+struct Readback {
+  Microsoft::WRL::ComPtr<ID3D12Resource> buffer;
+  ID3D12Resource* source = nullptr;
+  D3D12_RESOURCE_STATES state =
+      D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+  D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint = {};
+  UINT rows = 0;
+  UINT64 row_size = 0;
+  uint64_t submission = 0;
+  std::string path;
+  uint32_t width = 0, height = 0;
+  uint32_t format = 0;
+};
+
+FrameState g_state;
+std::vector<std::unique_ptr<Readback>> g_pending;
+int g_dump_frames_left = 0;      // frames still to capture after the trigger
+bool g_dump_this_frame = false;  // capture during the current frame
+bool g_depth_dumped = false, g_color_dumped = false;
+uint32_t g_dump_seq = 0;
+
+void CopyCallback(ID3D12GraphicsCommandList* list, void* user) {
+  auto* rb = static_cast<Readback*>(user);
+  const D3D12_RESOURCE_STATES kSrv = rb->state;
+  D3D12_RESOURCE_BARRIER b = {};
+  b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  b.Transition.pResource = rb->source;
+  b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+  b.Transition.StateBefore = kSrv;
+  b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+  list->ResourceBarrier(1, &b);
+  D3D12_TEXTURE_COPY_LOCATION dst = {};
+  dst.pResource = rb->buffer.Get();
+  dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  dst.PlacedFootprint = rb->footprint;
+  D3D12_TEXTURE_COPY_LOCATION src = {};
+  src.pResource = rb->source;
+  src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  src.SubresourceIndex = 0;
+  list->CopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+  std::swap(b.Transition.StateBefore, b.Transition.StateAfter);
+  list->ResourceBarrier(1, &b);
+}
+
+void QueueCapture(D3D12CommandProcessor& cp, ID3D12Resource* resource, const char* what,
+                  D3D12_RESOURCE_STATES state =
+                      D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE |
+                      D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE) {
+  ID3D12Device* device = cp.GetD3D12Provider().GetDevice();
+  D3D12_RESOURCE_DESC desc = resource->GetDesc();
+  auto rb = std::make_unique<Readback>();
+  UINT64 total = 0;
+  device->GetCopyableFootprints(&desc, 0, 1, 0, &rb->footprint, &rb->rows, &rb->row_size, &total);
+  D3D12_HEAP_PROPERTIES hp = {};
+  hp.Type = D3D12_HEAP_TYPE_READBACK;
+  D3D12_RESOURCE_DESC bd = {};
+  bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+  bd.Width = total;
+  bd.Height = bd.DepthOrArraySize = bd.MipLevels = 1;
+  bd.SampleDesc.Count = 1;
+  bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+  if (FAILED(device->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &bd,
+                                             D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                             IID_PPV_ARGS(&rb->buffer)))) {
+    REXGPU_WARN("GOW2 dump: readback buffer creation failed");
+    return;
+  }
+  rb->source = resource;
+  rb->state = state;
+  rb->width = uint32_t(desc.Width);
+  rb->height = desc.Height;
+  rb->format = uint32_t(desc.Format);
+  char name[96];
+  std::snprintf(name, sizeof name, "gow2_dump/f%u_%s.bin", g_dump_seq, what);
+  rb->path = name;
+  cp.SubmitBarriers();
+  rb->submission = cp.GetCurrentSubmission();
+  Readback* raw = rb.get();
+  g_pending.push_back(std::move(rb));
+  cp.GetDeferredCommandList().Callback(&CopyCallback, raw);
+  REXGPU_WARN("GOW2 dump: queued {} {}x{} dxgi={} -> {}", what, raw->width, raw->height,
+              raw->format, raw->path);
+}
+
+void WriteCamera(uint32_t seq) {
+  char name[96];
+  std::snprintf(name, sizeof name, "gow2_dump/f%u_cam.txt", seq);
+  FILE* f = std::fopen(name, "w");
+  if (!f) return;
+  auto dump = [&](const char* tag, const SceneCamera& c) {
+    std::fprintf(f, "%s valid=%d matching=%u other=%u\n", tag, int(c.valid), c.draws_matching,
+                 c.draws_other);
+    for (int i = 0; i < 16; ++i)
+      std::fprintf(f, "%s c%d %.9g %.9g %.9g %.9g\n", tag, i, c.c[i][0], c.c[i][1], c.c[i][2],
+                   c.c[i][3]);
+  };
+  dump("cur", g_state.camera);
+  dump("prev", g_state.prev_camera);
+  std::fprintf(f, "scale %u %u\ndepth_dst %08X\ncolor_dst %08X\n", g_state.scale_x,
+               g_state.scale_y, g_state.depth_resolve_dst, g_state.color_resolve_dst);
+  std::fclose(f);
+}
+
+void FlushCompleted(D3D12CommandProcessor& cp) {
+  for (size_t i = 0; i < g_pending.size();) {
+    Readback& rb = *g_pending[i];
+    if (cp.GetCompletedSubmission() < rb.submission) {
+      ++i;
+      continue;
+    }
+    void* mapped = nullptr;
+    D3D12_RANGE range = {0, size_t(rb.footprint.Footprint.RowPitch) * rb.rows};
+    if (SUCCEEDED(rb.buffer->Map(0, &range, &mapped))) {
+      std::filesystem::create_directories("gow2_dump");
+      FILE* f = std::fopen(rb.path.c_str(), "wb");
+      if (f) {
+        uint32_t hdr[6] = {rb.width, rb.height, rb.format, rb.footprint.Footprint.RowPitch,
+                           rb.rows, 0};
+        std::fwrite(hdr, sizeof hdr, 1, f);
+        std::fwrite(mapped, 1, size_t(rb.footprint.Footprint.RowPitch) * rb.rows, f);
+        std::fclose(f);
+      }
+      D3D12_RANGE none = {0, 0};
+      rb.buffer->Unmap(0, &none);
+    }
+    g_pending.erase(g_pending.begin() + i);
+  }
+}
+
+}  // namespace
+
+FrameState& State() { return g_state; }
+
+void CaptureOutputIfRequested(D3D12CommandProcessor& cp, ID3D12Resource* output,
+                              D3D12_RESOURCE_STATES state) {
+  static uint32_t counter = 0, shot_seq = 0;
+  if ((++counter % 6) != 0) return;
+  std::error_code ec;
+  if (!std::filesystem::exists("gow2_shot.now", ec)) return;
+  std::filesystem::remove("gow2_shot.now", ec);
+  std::filesystem::create_directories("gow2_dump");
+  char what[32];
+  std::snprintf(what, sizeof what, "shot%u", shot_seq++);
+  uint32_t keep = g_dump_seq;
+  g_dump_seq = 0;
+  // QueueCapture names the file f<seq>_<what>.bin
+  QueueCapture(cp, output, what, state);
+  g_dump_seq = keep;
+}
+
+void BeginFrame(D3D12CommandProcessor& cp, uint32_t front_ptr) {
+  FlushCompleted(cp);
+  // Close out the previous frame's dump (camera text needs both cameras).
+  if (g_dump_this_frame) {
+    WriteCamera(g_dump_seq);
+    ++g_dump_seq;
+    g_dump_this_frame = false;
+  }
+  g_state.ended_camera = g_state.camera;
+  g_state.ended_prev_camera = g_state.prev_camera;
+  g_state.ended_frame = g_state.frame;
+  g_state.ended_jittered = g_state.jitter_this_frame;
+  g_state.prev_camera = g_state.camera;
+  g_state.camera = SceneCamera();
+  // The scene size comes from the finished frame: inside a frame, smaller colour resolves come
+  // before the scene's and would stop the jitter of the scene draws that follow them.
+  if (g_state.color_resolve_area) {
+    g_state.guest_w = g_state.color_resolve_w;
+    g_state.guest_h = g_state.color_resolve_h;
+  }
+  g_state.depth_resolve_dst = 0;
+  g_state.depth_resolve_area = 0;
+  g_state.depth_dst_count = 0;
+  g_state.color_resolve_dst = 0;
+  g_state.color_resolve_area = 0;
+  g_state.last_front = front_ptr;
+  ++g_state.frame;
+  g_state.shrink_this_frame = false;  // the whole guest frame is rendered at the render size now
+  g_state.jitter_this_frame = g_state.jitter_next;
+  g_state.jitter_next = false;
+
+  if (g_dump_frames_left <= 0 && (g_state.frame % 30) == 0) {
+    std::error_code ec;
+    if (std::filesystem::exists("gow2_dump.now", ec)) {
+      std::filesystem::remove("gow2_dump.now", ec);
+      g_dump_frames_left = 2;
+      g_dump_seq = 0;
+    }
+  }
+  if (g_dump_frames_left > 0) {
+    --g_dump_frames_left;
+    g_dump_this_frame = true;
+    g_depth_dumped = g_color_dumped = false;
+    std::filesystem::create_directories("gow2_dump");
+  }
+}
+
+void NoteResolve(bool is_depth, uint32_t dst, uint32_t width, uint32_t height, uint32_t) {
+  // The scene's resolves are the first largest of the frame. Gears of War 2 resolves a 704x480 shadow
+  // map after the 1280x704 scene depth, and 640x352 and 328x184 colour buffers around the scene
+  // colour, so taking the last resolve picked the wrong targets and the scene was never jittered.
+  const uint32_t area = width * height;
+  if (is_depth) {
+    if (area > g_state.depth_resolve_area) {
+      g_state.depth_resolve_dst = dst;
+      g_state.depth_resolve_area = area;
+    }
+    bool known = false;
+    for (uint32_t i = 0; i < g_state.depth_dst_count; ++i) known |= g_state.depth_dsts[i] == dst;
+    if (!known && g_state.depth_dst_count < 4) g_state.depth_dsts[g_state.depth_dst_count++] = dst;
+  } else if (dst != g_state.last_front && area > g_state.color_resolve_area) {
+    g_state.color_resolve_dst = dst;
+    g_state.color_resolve_area = area;
+    g_state.color_resolve_w = width;
+    g_state.color_resolve_h = height;
+  }
+}
+
+bool Enabled() { return REXCVAR_GET(gow2_temporal) || SelectedUpscaler() != 0; }
+
+void SetUpscaleStatus(const char* text) {
+  static std::string last = "\x01";
+  if (last == text) return;
+  last = text;
+  const bool ok = rex::cvar::SetFlagByName("gow2_upscale_status", last);
+  REXGPU_WARN("GOW2 upscale status -> '{}' (set ok={}, read back '{}')", last, ok,
+              rex::cvar::GetFlagByName("gow2_upscale_status"));
+}
+
+bool ShouldJitter(const uint64_t* vs_float_bitmap, uint32_t surface_pitch,
+                  uint32_t color_fmt) {
+  if (!Enabled() || !g_state.jitter_this_frame) return false;
+  const int vp = std::clamp<int>(REXCVAR_GET(gow2_vp_register), 0, 252);
+  for (int r = 0; r < 4; ++r) {  // the world VS reads the whole ViewProjection matrix
+    const int reg = vp + r;
+    if (!(vs_float_bitmap[reg / 64] & (uint64_t(1) << (reg % 64)))) return false;
+  }
+  if (!g_state.guest_w || surface_pitch != g_state.guest_w) return false;  // not the scene surface
+  (void)color_fmt;
+  return true;
+}
+
+static double Halton(uint32_t i, uint32_t b) {
+  double f = 1.0, r = 0.0;
+  while (i > 0) {
+    f /= b;
+    r += f * (i % b);
+    i /= b;
+  }
+  return r;
+}
+
+void JitterPixels(float out[2]) { JitterPixelsForFrame(g_state.frame, out); }
+
+void JitterPixelsForFrame(uint32_t frame, float out[2]) {
+  int phases = std::max(1, REXCVAR_GET(gow2_jitter_phases));
+  uint32_t i = (frame % uint32_t(phases)) + 1;
+  double s = REXCVAR_GET(gow2_jitter_scale);
+  out[0] = float((Halton(i, 2) - 0.5) * s);
+  out[1] = float((Halton(i, 3) - 0.5) * s);
+}
+
+void JitterNdc(uint32_t host_w, uint32_t host_h, float out[2]) {
+  float px[2];
+  JitterPixels(px);
+  out[0] = 2.0f * px[0] / float(host_w);
+  out[1] = -2.0f * px[1] / float(host_h);
+}
+
+void NoteSceneDraw(const float* vs_consts, uint32_t color_fmt, uint32_t index_count) {
+  if (color_fmt != 3 || index_count < 30) return;
+  const int vp = std::clamp<int>(REXCVAR_GET(gow2_vp_register), 0, 240);
+  const float* rows = vs_consts + vp * 4;
+  for (int i = 0; i < 16; ++i) {
+    for (int k = 0; k < 4; ++k)
+      if (!std::isfinite(rows[i * 4 + k]) || std::fabs(rows[i * 4 + k]) > 1e7f) return;
+  }
+  SceneCamera& cam = g_state.camera;
+  if (!cam.valid) {
+    std::memcpy(cam.c, rows, sizeof cam.c);
+    cam.valid = true;
+    cam.draws_matching = 1;
+    return;
+  }
+  if (std::memcmp(cam.c, rows, 4 * 4 * sizeof(float)) == 0)
+    ++cam.draws_matching;
+  else
+    ++cam.draws_other;
+}
+
+int FindCameraMatrix(const float* vs_consts) {
+  const SceneCamera& cam = g_state.camera;
+  if (!cam.valid) return -1;
+  for (int r = 0; r + 4 <= 256; ++r) {
+    if (std::memcmp(cam.c, vs_consts + r * 4, 4 * 4 * sizeof(float)) == 0) return r;
+  }
+  return -1;
+}
+
+void OnDrawTextures(D3D12CommandProcessor& cp, D3D12TextureCache& tc, const RegisterFile& regs,
+                    uint32_t used_mask) {
+  const bool upscale = UpscaleEnabled();
+  if (!upscale && (!g_dump_this_frame || (g_depth_dumped && g_color_dumped))) return;
+  for (uint32_t i = 0; i < 32; ++i) {
+    if (!(used_mask & (1u << i))) continue;
+    xenos::xe_gpu_texture_fetch_t tf = regs.GetTextureFetch(i);
+    uint32_t base = uint32_t(tf.base_address) << 12;
+    if (upscale) {
+      bool is_depth_dst = false;
+      for (uint32_t k = 0; k < g_state.depth_dst_count; ++k) is_depth_dst |= base == g_state.depth_dsts[k];
+      if (is_depth_dst) {
+        uint32_t w, h;
+        if (ID3D12Resource* r = tc.GetActiveTextureResource(i, &w, &h)) NoteDepthTexture(r);
+      } else if (g_state.color_resolve_dst && base == g_state.color_resolve_dst) {
+        uint32_t w, h;
+        (void)w;
+        (void)h;
+      }
+    }
+    if (!g_dump_this_frame || (g_depth_dumped && g_color_dumped)) continue;
+    bool want_depth = !g_depth_dumped && g_state.depth_resolve_dst && base == g_state.depth_resolve_dst;
+    bool want_color = !g_color_dumped && g_state.color_resolve_dst && base == g_state.color_resolve_dst;
+    if (!want_depth && !want_color) continue;
+    uint32_t w = 0, h = 0;
+    ID3D12Resource* res = tc.GetActiveTextureResource(i, &w, &h);
+    if (!res) continue;
+    QueueCapture(cp, res, want_depth ? "depth" : "color");
+    (want_depth ? g_depth_dumped : g_color_dumped) = true;
+  }
+}
+
+}  // namespace rex::graphics::d3d12::gow2
diff --git a/src/graphics/d3d12/gow2_upscale.cpp b/src/graphics/d3d12/gow2_upscale.cpp
new file mode 100644
index 0000000..8a86043
--- /dev/null
+++ b/src/graphics/d3d12/gow2_upscale.cpp
@@ -0,0 +1,766 @@
+// Adapted from gears-judgement-recomp (BSD-3-Clause).
+// Temporal upscaler pass runner: camera motion vectors -> DLSS -> write back into the scene colour
+// texture, all recorded as one callback in the guest command stream.
+#include <wrl/client.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <string>
+#include <cstring>
+#include <memory>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/graphics/d3d12/command_processor.h>
+#include <rex/graphics/d3d12/deferred_command_list.h>
+#include <rex/graphics/d3d12/gow2_dlss.h>
+#include <rex/graphics/d3d12/gow2_fsr.h>
+#include <rex/graphics/d3d12/gow2_temporal.h>
+#include <rex/graphics/d3d12/texture_cache.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_BOOL(gow2_dlss, false, "gfx", "Run NVIDIA DLSS on the scene colour (needs gow2_temporal)");
+REXCVAR_DEFINE_STRING(gow2_upscaler, "off", "gfx",
+                      "Temporal upscaler: off, dlss, fsr3 (FSR 3.1), fsr4, auto (dlss, else fsr3)");
+REXCVAR_DEFINE_INT32(gow2_upscale_quality, -1, "gfx",
+                     "Upscaler mode: -1 auto (from the quality level: Low performance, Medium balanced, "
+                     "High quality), 0 performance, 1 balanced, 2 quality, 3 ultra performance, "
+                     "4 ultra quality, 5 native (DLAA)");
+REXCVAR_DEFINE_DOUBLE(gow2_render_scale, 0.0, "gfx",
+                      "Scene render scale for the upscaler (0 = from the DLSS quality mode, 1 = native)");
+REXCVAR_DEFINE_BOOL(gow2_dlss_hdr, false, "gfx", "Tell DLSS the scene colour is HDR/linear");
+REXCVAR_DEFINE_INT32(gow2_mv_debug, 0, "gfx",
+                     "1 = write the motion vectors into the scene colour instead of the upscaled "
+                     "image (debug), 2 = bypass (copy input colour back)");
+REXCVAR_DEFINE_BOOL(gow2_upscale_typed_copy, false, "gfx",
+                    "Give FSR the same typed copy of the frame that DLSS always reads (debug: "
+                    "exercises the DLSS input path on any GPU)");
+
+REXCVAR_DECLARE(int32_t, gow2_vp_register);
