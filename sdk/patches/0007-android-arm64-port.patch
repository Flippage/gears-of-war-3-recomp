+// "key 0123ABCD base 0 pitch 16 msaa 0 depth fmt 1"
+std::string VulkanRenderTargetCache::DescribeAndroidRenderTarget(
+    const RenderTarget* render_target) {
+  if (!render_target) {
+    return "-";
+  }
+  const RenderTargetKey key = render_target->key();
