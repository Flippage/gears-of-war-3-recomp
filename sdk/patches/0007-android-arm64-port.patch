+// The Android draw diagnostics: which draws each vulkan_android_depth_experiment bit, shader hash
+// list and draw range selects.
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstdint>
+#include <vector>
+
+#include <rex/graphics/vulkan/android_draw_experiments.h>
+
+namespace ax = rex::graphics::vulkan::android_experiments;
+
+namespace {
+
+constexpr uint32_t kCompareLess = 1;
+constexpr uint64_t kVertexShader = 0x1111222233334444ull;
+constexpr uint64_t kPixelShader = 0xC84DBBA59A174733ull;
+
+ax::DrawFacts PrepassMesh() {
+  ax::DrawFacts draw;
+  draw.float24_depth_bound = true;
+  draw.depth_test_enabled = true;
+  draw.depth_compare = ax::kCompareGreaterEqual;
+  draw.depth_write = true;
+  draw.vertex_shader_hash = kVertexShader;
+  return draw;
+}
+
+ax::DrawFacts DepthClearRectangle() {
+  ax::DrawFacts draw;
+  draw.float24_depth_bound = true;
+  draw.rectangle_list = true;
+  draw.depth_test_enabled = true;
+  draw.depth_compare = ax::kCompareAlways;
+  draw.depth_write = true;
+  draw.vertex_shader_hash = kVertexShader;
+  return draw;
+}
+
+ax::DrawFacts BasePassDraw() {
+  ax::DrawFacts draw = PrepassMesh();
+  draw.has_pixel_shader = true;
+  draw.pixel_shader_hash = kPixelShader;
+  return draw;
+}
+
+// Numbers a frame's draws as the command processor does and returns each one's skip reason.
+std::vector<ax::SkipReason> SkipReasonsOfFrame(int32_t bits, const ax::DrawSkipLists& lists,
+                                               std::vector<ax::DrawFacts> frame) {
+  std::vector<ax::SkipReason> reasons;
+  bool saw_prepass_mesh = false;
+  for (uint32_t i = 0; i < frame.size(); ++i) {
+    frame[i].frame_draw_index = i;
+    frame[i].frame_saw_prepass_mesh = saw_prepass_mesh;
+    saw_prepass_mesh = ax::FrameSawPrepassMeshAfter(frame[i]);
+    reasons.push_back(ax::GetDrawSkipReason(bits, lists, frame[i]));
+  }
+  return reasons;
+}
+
+}  // namespace
+
+TEST_CASE("shader hash lists take FRAMETRACE's hex and drop the rest", "[android][draw]") {
+  const std::vector<uint64_t> hashes =
+      ax::ParseShaderHashList(" C84DBBA59A174733, 0x5e9c75a1b61cfc48 ,junk,,0,12345678901234567");
+  REQUIRE(hashes.size() == 2);
+  CHECK(hashes[0] == 0xC84DBBA59A174733ull);
+  CHECK(hashes[1] == 0x5E9C75A1B61CFC48ull);
+  CHECK(ax::ParseShaderHashList("").empty());
+}
+
+TEST_CASE("a draw range is one number or first-last", "[android][draw]") {
+  const auto single = ax::ParseDrawIndexRange("575");
+  REQUIRE(single.has_value());
+  CHECK(single->first == 575);
+  CHECK(single->last == 575);
+  const auto range = ax::ParseDrawIndexRange(" 576 - 2460 ");
+  REQUIRE(range.has_value());
+  CHECK(range->Contains(576));
+  CHECK(range->Contains(2460));
+  CHECK_FALSE(range->Contains(575));
+  CHECK_FALSE(range->Contains(2461));
+  CHECK_FALSE(ax::ParseDrawIndexRange("").has_value());
+  CHECK_FALSE(ax::ParseDrawIndexRange("10-5").has_value());
+  CHECK_FALSE(ax::ParseDrawIndexRange("a-b").has_value());
+  CHECK_FALSE(ax::ParseDrawIndexRange("3-").has_value());
+}
+
+TEST_CASE("bit 128 skips the prepass meshes and keeps the depth clears", "[android][draw]") {
+  const auto reasons = SkipReasonsOfFrame(
+      ax::kSkipPrepassMeshes, {}, {DepthClearRectangle(), PrepassMesh(), DepthClearRectangle()});
+  CHECK(reasons == std::vector<ax::SkipReason>{ax::SkipReason::kNone, ax::SkipReason::kPrepassMesh,
+                                               ax::SkipReason::kNone});
+}
+
+TEST_CASE("bit 2 skips every depth-only draw on the float24 depth", "[android][draw]") {
+  const auto reasons = SkipReasonsOfFrame(ax::kSkipDepthOnlyFloat24Draws, {},
+                                          {DepthClearRectangle(), PrepassMesh(), BasePassDraw()});
+  CHECK(reasons == std::vector<ax::SkipReason>{ax::SkipReason::kDepthOnlyFloat24,
+                                               ax::SkipReason::kDepthOnlyFloat24,
+                                               ax::SkipReason::kNone});
+}
+
+TEST_CASE("bit 512 keeps the frame's first depth clear and skips the ones after the prepass",
+          "[android][draw]") {
+  ax::DrawFacts depth_tested_rectangle = DepthClearRectangle();
+  depth_tested_rectangle.depth_compare = ax::kCompareGreaterEqual;
+  ax::DrawFacts colored_rectangle = DepthClearRectangle();
+  colored_rectangle.has_pixel_shader = true;
+  const auto reasons = SkipReasonsOfFrame(
+      ax::kSkipMidFrameDepthClears, {},
+      {DepthClearRectangle(), PrepassMesh(), PrepassMesh(), DepthClearRectangle(), BasePassDraw(),
+       depth_tested_rectangle, colored_rectangle, DepthClearRectangle()});
+  CHECK(reasons == std::vector<ax::SkipReason>{
+                       ax::SkipReason::kNone, ax::SkipReason::kNone, ax::SkipReason::kNone,
+                       ax::SkipReason::kMidFrameDepthClear, ax::SkipReason::kNone,
+                       ax::SkipReason::kNone, ax::SkipReason::kNone,
+                       ax::SkipReason::kMidFrameDepthClear});
+}
+
+TEST_CASE("a prepass mesh skipped by bit 128 still starts the prepass for bit 512",
+          "[android][draw]") {
+  const auto reasons =
+      SkipReasonsOfFrame(ax::kSkipPrepassMeshes | ax::kSkipMidFrameDepthClears, {},
+                         {DepthClearRectangle(), PrepassMesh(), DepthClearRectangle()});
+  CHECK(reasons == std::vector<ax::SkipReason>{ax::SkipReason::kNone, ax::SkipReason::kPrepassMesh,
+                                               ax::SkipReason::kMidFrameDepthClear});
+}
+
+TEST_CASE("listed shaders and the draw range skip draws with no experiment bit",
+          "[android][draw]") {
+  ax::DrawSkipLists by_pixel_shader;
+  by_pixel_shader.shader_hashes = {kPixelShader};
+  CHECK(SkipReasonsOfFrame(0, by_pixel_shader, {PrepassMesh(), BasePassDraw()}) ==
+        std::vector<ax::SkipReason>{ax::SkipReason::kNone, ax::SkipReason::kShaderHash});
+
+  ax::DrawSkipLists by_vertex_shader;
+  by_vertex_shader.shader_hashes = {kVertexShader};
+  CHECK(SkipReasonsOfFrame(0, by_vertex_shader, {PrepassMesh(), BasePassDraw()}) ==
+        std::vector<ax::SkipReason>{ax::SkipReason::kShaderHash, ax::SkipReason::kShaderHash});
+
+  ax::DrawSkipLists by_index;
+  by_index.draw_indices = ax::DrawIndexRange{1, 1};
+  CHECK(SkipReasonsOfFrame(0, by_index, {PrepassMesh(), PrepassMesh(), BasePassDraw()}) ==
+        std::vector<ax::SkipReason>{ax::SkipReason::kNone, ax::SkipReason::kDrawIndex,
+                                    ax::SkipReason::kNone});
+}
+
+TEST_CASE("a draw without a pixel shader never matches a listed hash through its zero hash",
+          "[android][draw]") {
+  ax::DrawSkipLists lists;
+  lists.shader_hashes = {0, kPixelShader};
+  CHECK_FALSE(ax::IsListedShader(lists.shader_hashes, 0x9999ull, 0));
+}
+
+TEST_CASE("bit 1 relaxes color draws without depth writes, bit 256 also the writers on float24",
+          "[android][draw]") {
+  constexpr uint32_t kColor = 0xF;
+  CHECK(ax::IsColorDepthTestRelaxed(ax::kDepthAlwaysForColorWithoutWrites, true, kColor, false,
+                                    true));
+  CHECK_FALSE(ax::IsColorDepthTestRelaxed(ax::kDepthAlwaysForColorWithoutWrites, true, kColor,
+                                          true, true));
+  CHECK(ax::IsColorDepthTestRelaxed(ax::kDepthAlwaysForFloat24Color, true, kColor, true, true));
+  CHECK_FALSE(
+      ax::IsColorDepthTestRelaxed(ax::kDepthAlwaysForFloat24Color, true, kColor, true, false));
+  CHECK_FALSE(ax::IsColorDepthTestRelaxed(ax::kDepthAlwaysForFloat24Color, false, 0, true, true));
+  CHECK_FALSE(ax::IsColorDepthTestRelaxed(ax::kDepthAlwaysForFloat24Color, true, 0, true, true));
+  CHECK_FALSE(ax::IsColorDepthTestRelaxed(0, true, kColor, false, true));
+}
+
+TEST_CASE("bit 1024 paints depth-only float24 draws where color target 0 is bound",
+          "[android][draw]") {
+  CHECK(ax::IsPrepassPainted(ax::kPaintPrepass, false, true, true));
+  CHECK_FALSE(ax::IsPrepassPainted(ax::kPaintPrepass, false, true, false));
+  CHECK_FALSE(ax::IsPrepassPainted(ax::kPaintPrepass, true, true, true));
+  CHECK_FALSE(ax::IsPrepassPainted(ax::kPaintPrepass, false, false, true));
+  CHECK_FALSE(ax::IsPrepassPainted(0, false, true, true));
+}
+
+TEST_CASE("the color depth bias reaches only nearer-passing color draws on float24",
+          "[android][draw]") {
+  constexpr float kBias = 16.0f;
+  CHECK(ax::GetColorDepthBias(kBias, true, 0xF, true, true, ax::kCompareGreaterEqual) == kBias);
+  CHECK(ax::GetColorDepthBias(kBias, true, 0xF, true, true, ax::kCompareGreater) == kBias);
+  CHECK(ax::GetColorDepthBias(kBias, true, 0xF, true, true, kCompareLess) == 0.0f);
+  CHECK(ax::GetColorDepthBias(kBias, true, 0xF, true, true, ax::kCompareAlways) == 0.0f);
+  CHECK(ax::GetColorDepthBias(kBias, true, 0xF, true, false, ax::kCompareGreaterEqual) == 0.0f);
+  CHECK(ax::GetColorDepthBias(kBias, true, 0, true, true, ax::kCompareGreaterEqual) == 0.0f);
+  CHECK(ax::GetColorDepthBias(kBias, false, 0xF, true, true, ax::kCompareGreaterEqual) == 0.0f);
+  CHECK(ax::GetColorDepthBias(kBias, true, 0xF, false, true, ax::kCompareGreaterEqual) == 0.0f);
+}
+
+TEST_CASE("the color depth bias default applies only on Qualcomm unless the user sets it",
+          "[android][draw]") {
+  constexpr float kDefault = 16.0f;
+  CHECK(ax::ResolveColorDepthBias(kDefault, false, ax::kQualcommVendorId) == kDefault);
+  CHECK(ax::ResolveColorDepthBias(kDefault, false, 0x13B5) == 0.0f);  // ARM Mali
+  CHECK(ax::ResolveColorDepthBias(kDefault, false, 0x1002) == 0.0f);  // AMD (Samsung Xclipse)
+  CHECK(ax::ResolveColorDepthBias(kDefault, false, 0x1010) == 0.0f);  // Imagination PowerVR
+  CHECK(ax::ResolveColorDepthBias(8.0f, true, 0x13B5) == 8.0f);
+  CHECK(ax::ResolveColorDepthBias(0.0f, true, ax::kQualcommVendorId) == 0.0f);
+  CHECK(ax::ResolveColorDepthBias(-4.0f, true, ax::kQualcommVendorId) == -4.0f);
+}
diff --git a/tests/unit/graphics/pipeline_cache_file_test.cpp b/tests/unit/graphics/pipeline_cache_file_test.cpp
new file mode 100644
index 0000000..96ade6c
--- /dev/null
+++ b/tests/unit/graphics/pipeline_cache_file_test.cpp
@@ -0,0 +1,180 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstdint>
+#include <cstring>
+#include <string_view>
+#include <vector>
+
+#include <rex/graphics/vulkan/pipeline_cache_file.h>
+
+namespace pc = rex::graphics::vulkan::pipeline_cache_file;
+
+namespace {
+
+pc::DeviceIdentity TestDevice() {
+  pc::DeviceIdentity device;
+  device.vendor_id = 0x12345678;
+  device.device_id = 0x90ABCDEF;
+  device.driver_version = 0x11223344;
+  for (size_t i = 0; i < 16; ++i) {
+    device.pipeline_cache_uuid[i] = uint8_t(i + 1);
+  }
+  return device;
+}
+
+void SetWord(std::vector<uint8_t>& bytes, size_t offset, uint32_t value) {
+  for (size_t i = 0; i < 4; ++i) {
+    bytes[offset + i] = uint8_t(value >> (i * 8));
+  }
+}
+
+std::vector<uint8_t> DriverData(const pc::DeviceIdentity& device) {
+  std::vector<uint8_t> data(40, 0xA5);
+  SetWord(data, 0, uint32_t(pc::kVulkanHeaderSize));
+  SetWord(data, 4, pc::kVulkanHeaderVersionOne);
+  SetWord(data, 8, device.vendor_id);
+  SetWord(data, 12, device.device_id);
+  std::memcpy(data.data() + 16, device.pipeline_cache_uuid, 16);
+  return data;
+}
+
+void CheckStatus(const std::vector<uint8_t>& file, const pc::DeviceIdentity& device,
+                 pc::LoadStatus expected) {
+  const pc::Unwrapped result = pc::Unwrap(file.data(), file.size(), device);
+  CHECK(result.status == expected);
+  CHECK(result.data_offset == 0);
+  CHECK(result.data_size == 0);
+}
+
+void CheckLittleEndian(const std::vector<uint8_t>& file, size_t offset, uint64_t value,
+                       size_t size) {
+  for (size_t i = 0; i < size; ++i) {
+    CHECK(file[offset + i] == uint8_t(value >> (i * 8)));
+  }
+}
+
+}  // namespace
+
+TEST_CASE("pipeline cache files round trip driver data at the documented offsets",
+          "[vulkan][pipeline-cache]") {
+  const auto device = TestDevice();
+  const auto data = DriverData(device);
+  const auto file = pc::Wrap(device, data.data(), data.size());
+  const auto result = pc::Unwrap(file.data(), file.size(), device);
+  REQUIRE(result.status == pc::LoadStatus::kOk);
+  CHECK(result.data_offset == pc::kHeaderSize);
+  CHECK(result.data_size == data.size());
+  CHECK(file.size() == pc::kHeaderSize + data.size());
+  CHECK(std::memcmp(file.data() + result.data_offset, data.data(), data.size()) == 0);
+  CheckLittleEndian(file, 0, pc::kMagic, 4);
+  CheckLittleEndian(file, 4, pc::kVersion, 4);
+  CheckLittleEndian(file, 8, device.vendor_id, 4);
+  CheckLittleEndian(file, 12, device.device_id, 4);
+  CheckLittleEndian(file, 16, device.driver_version, 4);
+  CheckLittleEndian(file, 20, 0, 4);
+  CHECK(std::memcmp(file.data() + 24, device.pipeline_cache_uuid, 16) == 0);
+  CheckLittleEndian(file, 40, data.size(), 8);
+  CheckLittleEndian(file, 48, XXH3_64bits(data.data(), data.size()), 8);
+  CHECK(pc::HashData(data.data(), data.size()) == XXH3_64bits(data.data(), data.size()));
+}
+
+TEST_CASE("pipeline cache files reject missing or unsupported outer headers",
+          "[vulkan][pipeline-cache]") {
+  const auto device = TestDevice();
+  const auto data = DriverData(device);
+  auto file = pc::Wrap(device, data.data(), data.size());
+  SECTION("empty file") {
+    CheckStatus({}, device, pc::LoadStatus::kEmpty);
+  }
+  SECTION("short header") {
+    CheckStatus(std::vector<uint8_t>(55), device, pc::LoadStatus::kTooSmall);
+  }
+  SECTION("wrong magic") {
+    SetWord(file, 0, 0);
+    CheckStatus(file, device, pc::LoadStatus::kBadMagic);
+  }
+  SECTION("unsupported version") {
+    SetWord(file, 4, 2);
+    CheckStatus(file, device, pc::LoadStatus::kBadVersion);
+  }
+}
+
+TEST_CASE("pipeline cache files bind the driver data to the device and driver",
+          "[vulkan][pipeline-cache]") {
+  auto device = TestDevice();
+  const auto data = DriverData(device);
+  const auto file = pc::Wrap(device, data.data(), data.size());
+  SECTION("other vendor") { ++device.vendor_id; }
+  SECTION("other device") { ++device.device_id; }
+  SECTION("other driver") { ++device.driver_version; }
+  SECTION("other UUID") { ++device.pipeline_cache_uuid[7]; }
+  CheckStatus(file, device, pc::LoadStatus::kOtherDevice);
+}
+
+TEST_CASE("pipeline cache files reject changed lengths and contents", "[vulkan][pipeline-cache]") {
+  const auto device = TestDevice();
+  const auto data = DriverData(device);
+  auto file = pc::Wrap(device, data.data(), data.size());
+  SECTION("appended byte") {
+    file.push_back(0);
+    CheckStatus(file, device, pc::LoadStatus::kBadSize);
+  }
+  SECTION("changed driver byte") {
+    file.back() ^= 1;
+    CheckStatus(file, device, pc::LoadStatus::kBadHash);
+  }
+}
+
+TEST_CASE("pipeline cache files validate the wrapped Vulkan header", "[vulkan][pipeline-cache]") {
+  const auto device = TestDevice();
+  auto data = DriverData(device);
+  SECTION("unsupported header version") { SetWord(data, 4, 2); }
+  SECTION("other UUID") { data[23] ^= 1; }
+  SECTION("short data") { data.resize(16); }
+  SECTION("header larger than the data") { SetWord(data, 0, 64); }
+  SECTION("header smaller than the Vulkan header") { SetWord(data, 0, 31); }
+  SECTION("other vendor") { SetWord(data, 8, device.vendor_id + 1); }
+  SECTION("other device") { SetWord(data, 12, device.device_id + 1); }
+  const auto file = pc::Wrap(device, data.data(), data.size());
+  CheckStatus(file, device, pc::LoadStatus::kBadVulkanHeader);
+}
+
+TEST_CASE("pipeline cache files report the first failed check", "[vulkan][pipeline-cache]") {
+  const auto device = TestDevice();
+  auto data = DriverData(device);
+  SetWord(data, 4, 2);
+  auto file = pc::Wrap(device, data.data(), data.size());
+  file.back() ^= 1;
+  CheckStatus(file, device, pc::LoadStatus::kBadHash);
+  file.push_back(0);
+  CheckStatus(file, device, pc::LoadStatus::kBadSize);
+  file[24] ^= 1;
+  CheckStatus(file, device, pc::LoadStatus::kOtherDevice);
+  SetWord(file, 4, 2);
+  CheckStatus(file, device, pc::LoadStatus::kBadVersion);
+  SetWord(file, 0, 0);
+  CheckStatus(file, device, pc::LoadStatus::kBadMagic);
+  file.resize(55);
+  CheckStatus(file, device, pc::LoadStatus::kTooSmall);
+  file.clear();
+  CheckStatus(file, device, pc::LoadStatus::kEmpty);
+}
+
+TEST_CASE("pipeline cache status names are distinct and non-empty", "[vulkan][pipeline-cache]") {
+  const std::vector<pc::LoadStatus> statuses = {
+      pc::LoadStatus::kOk,           pc::LoadStatus::kEmpty,   pc::LoadStatus::kTooSmall,
+      pc::LoadStatus::kBadMagic,     pc::LoadStatus::kBadVersion,
+      pc::LoadStatus::kOtherDevice,  pc::LoadStatus::kBadSize, pc::LoadStatus::kBadHash,
+      pc::LoadStatus::kBadVulkanHeader};
+  const std::vector<std::string_view> expected = {
+      "ok",         "empty",    "too small", "bad magic", "bad version",
+      "other device or driver", "bad size", "bad hash", "bad Vulkan header"};
+  for (size_t i = 0; i < statuses.size(); ++i) {
+    const std::string_view name = pc::LoadStatusName(statuses[i]);
+    CHECK_FALSE(name.empty());
+    CHECK(name == expected[i]);
+    for (size_t j = 0; j < i; ++j) {
+      CHECK(name != pc::LoadStatusName(statuses[j]));
+    }
+  }
+}
diff --git a/tests/unit/ppc/fpscr_rounding_test.cpp b/tests/unit/ppc/fpscr_rounding_test.cpp
new file mode 100644
index 0000000..3eddabb
--- /dev/null
+++ b/tests/unit/ppc/fpscr_rounding_test.cpp
@@ -0,0 +1,113 @@
+// The guest's FPSCR rounding mode as mtfsf writes it and mffs reads it back, on x64 and arm64.
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <atomic>
+#include <cstdint>
+
+#include <rex/platform/fpscr.h>
+#include <rex/ppc/context.h>
+
+using rex::platform::FPSCRRoundingArm64;
+using rex::platform::FPSCRRoundingX64;
+using rex::platform::GuestRoundingFromHost;
+
+namespace {
+
+// One IEEE rounding direction as each register encodes it: MXCSR.RC (Intel SDM vol. 1, 10.2.3),
+// FPCR.RMode (Arm ARM, FPCR) and the guest's FPSCR[RN] (PowerPC UISA, 4.2.2).
+struct Direction {
+  const char* name;
+  uint32_t mxcsr_rc;
+  uint32_t fpcr_rmode;
+  uint32_t guest_rn;
+};
+
+constexpr Direction kDirections[] = {
+    {"to nearest", 0, 0, rex::ppc::kRoundNearest},
+    {"toward zero", 3, 3, rex::ppc::kRoundTowardZero},
+    {"toward +infinity", 2, 1, rex::ppc::kRoundUp},
+    {"toward -infinity", 1, 2, rex::ppc::kRoundDown},
+};
+
+// Bits outside the rounding field that a live control register carries (MXCSR: masks and
+// FTZ/DAZ; FPCR: FZ, FZ16 and an exception enable).
+constexpr uint32_t kOtherMxcsrBits = 0x9FC0;
+constexpr uint32_t kOtherFpcrBits = (1u << 19) | (1u << 24) | (1u << 8);
+
+template <typename Rounding>
+uint32_t HostFieldOf(uint32_t guest_mode) {
+  return uint32_t(Rounding::GuestToHost[guest_mode] >> Rounding::RoundShift);
+}
+
+// 1/3 in the guest's rounding mode, with the division kept between the mode switches.
+float DivideInGuestMode(PPCFPSCRRegister& fpscr, uint32_t mode, float numerator) {
+  fpscr.storeFromGuest(mode);
+  std::atomic_signal_fence(std::memory_order_seq_cst);
+  volatile float n = numerator;
+  volatile float d = 3.0f;
+  volatile float quotient = n / d;
+  std::atomic_signal_fence(std::memory_order_seq_cst);
+  return quotient;
+}
+
+}  // namespace
+
+TEST_CASE("mffs reads each host rounding direction as the mode the PC reads", "[ppc][fpscr]") {
+  for (const Direction& d : kDirections) {
+    INFO(d.name);
+    CHECK(GuestRoundingFromHost<FPSCRRoundingX64>(d.mxcsr_rc << FPSCRRoundingX64::RoundShift) ==
+          d.guest_rn);
+    CHECK(GuestRoundingFromHost<FPSCRRoundingArm64>(d.fpcr_rmode << FPSCRRoundingArm64::RoundShift) ==
+          d.guest_rn);
+  }
+}
+
+TEST_CASE("mtfsf selects the host direction the guest mode names", "[ppc][fpscr]") {
+  for (const Direction& d : kDirections) {
+    INFO(d.name);
+    CHECK(HostFieldOf<FPSCRRoundingX64>(d.guest_rn) == d.mxcsr_rc);
+    CHECK(HostFieldOf<FPSCRRoundingArm64>(d.guest_rn) == d.fpcr_rmode);
+  }
+}
+
+TEST_CASE("a guest mode written and read back is unchanged on both hosts", "[ppc][fpscr]") {
+  for (uint32_t mode = 0; mode < 4; ++mode) {
+    INFO("guest mode " << mode);
+    const uint32_t mxcsr = kOtherMxcsrBits | uint32_t(FPSCRRoundingX64::GuestToHost[mode]);
+    const uint32_t fpcr = kOtherFpcrBits | uint32_t(FPSCRRoundingArm64::GuestToHost[mode]);
+    CHECK(GuestRoundingFromHost<FPSCRRoundingX64>(mxcsr) == mode);
+    CHECK(GuestRoundingFromHost<FPSCRRoundingArm64>(fpcr) == mode);
+  }
+}
+
+TEST_CASE("this host's FPSCR register reads back what the guest wrote", "[ppc][fpscr]") {
+  PPCFPSCRRegister fpscr{};
+  fpscr.InitHost();
+  const uint32_t saved = fpscr.getcsr();
+  uint32_t read_back[4] = {};
+  for (uint32_t mode = 0; mode < 4; ++mode) {
+    fpscr.storeFromGuest(mode);
+    read_back[mode] = fpscr.loadFromHost();
+  }
+  fpscr.setcsr(saved);
+  for (uint32_t mode = 0; mode < 4; ++mode) {
+    INFO("guest mode " << mode);
+    CHECK(read_back[mode] == mode);
+  }
+}
+
+TEST_CASE("this host rounds in the direction the guest mode names", "[ppc][fpscr]") {
+  PPCFPSCRRegister fpscr{};
+  fpscr.InitHost();
+  const uint32_t saved = fpscr.getcsr();
+  const float up = DivideInGuestMode(fpscr, rex::ppc::kRoundUp, 1.0f);
+  const float down = DivideInGuestMode(fpscr, rex::ppc::kRoundDown, 1.0f);
+  const float nearest = DivideInGuestMode(fpscr, rex::ppc::kRoundNearest, 1.0f);
+  const float negative_toward_zero = DivideInGuestMode(fpscr, rex::ppc::kRoundTowardZero, -1.0f);
+  const float negative_down = DivideInGuestMode(fpscr, rex::ppc::kRoundDown, -1.0f);
+  fpscr.setcsr(saved);
+  CHECK(up > down);
+  CHECK((nearest == up || nearest == down));
+  CHECK(negative_toward_zero > negative_down);
+}
