+    case SDL_EVENT_MOUSE_BUTTON_DOWN:
+    case SDL_EVENT_MOUSE_BUTTON_UP:
+      which = event.button.which;
+      break;
+    case SDL_EVENT_MOUSE_WHEEL:
+      which = event.wheel.which;
+      break;
+    default:
+      return false;
+  }
+  return which == SDL_TOUCH_MOUSEID || which == SDL_PEN_MOUSEID;
+}
