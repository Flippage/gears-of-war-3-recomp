+  if (value.empty()) {
+    return std::nullopt;
+  }
+  auto xuid = ParseXuid(value);
+  if (!xuid) {
+    REXLOG_ERROR(
+        "user_xuid '{}' is not a usable XUID (1-16 hex digits, bits 54-55 clear); ignored",
+        value);
+  }
+  return xuid;
+}
