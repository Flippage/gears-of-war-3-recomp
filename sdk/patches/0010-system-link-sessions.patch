+void DisableUdpConnectionReset(uint64_t handle) {
+  BOOL report = FALSE;
+  DWORD returned = 0;
+  WSAIoctl(static_cast<SOCKET>(handle), SIO_UDP_CONNRESET, &report, sizeof(report), nullptr, 0,
+           &returned, nullptr, nullptr);
+}
+#endif
