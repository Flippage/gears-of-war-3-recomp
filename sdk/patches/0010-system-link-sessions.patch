+TEST_CASE("system_link: FormatIpv4 formats dotted quads", "[system][system_link]") {
+  CHECK(FormatIpv4(0x7F000002u) == "127.0.0.2");
+  CHECK(FormatIpv4(0u) == "0.0.0.0");
+  CHECK(FormatIpv4(0x0A0000FFu) == "10.0.0.255");
+}
