+// The engine binds its game socket to port 0 and reads the port the host chose from here; without
+// it a System Link join fails with "LiveSock: binding to port 0 failed".
+u32 NetDll_getsockname_entry(u32 caller, u32 socket_handle, ppc_ptr_t<XSOCKADDR_IN> name_ptr,
+                             mapped_u32 namelen_ptr) {
+  auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(socket_handle);
+  if (!socket) {
+    // WSAENOTSOCK
+    XThread::SetLastError(0x2736);
+    return -1;
+  }
+  if (!name_ptr || !namelen_ptr || namelen_ptr.value() < sizeof(XSOCKADDR_IN)) {
+    // WSAEFAULT
+    XThread::SetLastError(0x271E);
+    return -1;
+  }
+  N_XSOCKADDR_IN native_name;
+  int trace_ret = 0;
+  if (XFAILED(socket->GetSockName(&native_name))) {
+    XThread::SetLastError(XSocket::LastHostError());
+    trace_ret = -1;
+  } else {
+    name_ptr->sin_family = native_name.sin_family;
+    name_ptr->sin_port = native_name.sin_port;
+    name_ptr->sin_addr = native_name.sin_addr;
+    std::memset(name_ptr->x_sin_zero, 0, sizeof(name_ptr->x_sin_zero));
+    *namelen_ptr = sizeof(XSOCKADDR_IN);
+  }
+  static std::atomic<uint64_t> netlink_trace_count{0};
+  if (REXCVAR_GET(system_link_trace) && NetLinkTraceAllow(&netlink_trace_count)) {
+    uint32_t trace_ip;
+    uint16_t trace_port;
+    NetLinkSplitAddrIn(name_ptr, &trace_ip, &trace_port);
+    REXLOG_INFO("[netlink] getsockname s={:#010x} addr={}.{}.{}.{}:{} ret={}", socket_handle,
+                (trace_ip >> 24) & 0xFF, (trace_ip >> 16) & 0xFF, (trace_ip >> 8) & 0xFF,
+                trace_ip & 0xFF, trace_port, trace_ret);
+  }
+  return trace_ret;
+}
