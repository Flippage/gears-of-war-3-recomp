+
+void LogFirstBroadcastFanOut(uint16_t port, const std::vector<uint32_t>& destinations) {
+  static std::atomic<bool> logged{false};
+  if (logged.exchange(true)) {
+    return;
+  }
+  std::string list;
+  for (uint32_t ip : destinations) {
+    list += (list.empty() ? "" : ", ") + system_link::FormatIpv4(ip);
+  }
+  REXLOG_INFO(
+      "[netlink] broadcasts to port {} go out as unicast copies to [{}] "
+      "(net_broadcast_targets)",
+      port, list);
+}
