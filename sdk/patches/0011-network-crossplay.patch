+  }
+  for (char c : text) {
+    if (!IsDecimalDigit(c)) {
+      return std::nullopt;
+    }
+  }
+  int value = 0;
+  for (char c : text) {
+    value = value * static_cast<int>(kDecimalBase) + (c - '0');
+  }
