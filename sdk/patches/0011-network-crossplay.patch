+  CHECK(one_slot.TryTake(a, 1000));
+  CHECK(one_slot.TryTake(a, 1000));
+  CHECK(!one_slot.TryTake(a, 1000));
+  CHECK(one_slot.TryTake(b, 1000));
+  CHECK(one_slot.TryTake(a, 1000));
+
+  CHECK(clock.TryTake(a, 1000));
+  CHECK(clock.TryTake(a, 1000));
+  CHECK(!clock.TryTake(a, 500));
+}
