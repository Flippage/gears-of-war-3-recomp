+TEST_CASE("system_link: ReplyBudget limits and edge cases", "[system][system_link]") {
+  Endpoint a{0x0A000001u /* 10.0.0.1 */, 14001};
+  Endpoint b{0x0A000002u /* 10.0.0.2 */, 14001};
