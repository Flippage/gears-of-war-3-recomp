+ private:
+  struct Entry {
+    Endpoint source;
+    uint64_t hash;
+    size_t size;
+    uint64_t seen_ms;
+  };
+  uint64_t window_ms_;
+  size_t capacity_;
+  std::vector<Entry> entries_;
+};
