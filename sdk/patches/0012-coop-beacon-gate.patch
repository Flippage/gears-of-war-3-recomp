+template <class T>
+bool RememberOnce(std::vector<T>& seen, const T& value, size_t capacity) {
+  if (std::find(seen.begin(), seen.end(), value) != seen.end()) {
+    return false;
+  }
+  if (capacity == 0) {
+    return false;
+  }
+  if (seen.size() >= capacity) {
+    seen.erase(seen.begin());
+  }
+  seen.push_back(value);
+  return true;
+}
 
