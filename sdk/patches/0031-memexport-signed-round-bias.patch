Signed memexport rounding bias (Xenia canary da47dfaacf).
Packing signed normalized values for memory export wrote the copysign(0.5) bias over the exported
value itself and then added round_bias_temp, which nothing had written, so every signed memexport
(both the packed 8/16/32bpp path and 16_16_16_16) came out as garbage. Suspected for the black
blotches on Gears of War 3 faces in in-engine cutscenes, which sit where the face deforms.

--- a/src/graphics/pipeline/shader/dxbc_translator_memexport.cpp
+++ b/src/graphics/pipeline/shader/dxbc_translator_memexport.cpp
@@ -185,8 +185,8 @@
         while (rex::bit_scan_forward(eM_remaining, &eM_index)) {
           eM_remaining &= ~(uint8_t(1) << eM_index);
           uint32_t eM = system_temps_memexport_data_[eM_index];
-          a_.OpBFI(dxbc::Dest::R(eM, components), dxbc::Src::LU(31), dxbc::Src::LU(0),
-                   dxbc::Src::LF(0.5f), dxbc::Src::R(eM));
+          a_.OpBFI(dxbc::Dest::R(round_bias_temp, components), dxbc::Src::LU(31),
+                   dxbc::Src::LU(0), dxbc::Src::LF(0.5f), dxbc::Src::R(eM));
           a_.OpAdd(dxbc::Dest::R(eM, components), dxbc::Src::R(eM), dxbc::Src::R(round_bias_temp));
           a_.OpFToI(dxbc::Dest::R(eM, components), dxbc::Src::R(eM));
         }
@@ -398,8 +398,8 @@
         while (rex::bit_scan_forward(eM_remaining, &eM_index)) {
           eM_remaining &= ~(uint8_t(1) << eM_index);
           uint32_t eM = system_temps_memexport_data_[eM_index];
-          a_.OpBFI(dxbc::Dest::R(eM), dxbc::Src::LU(31), dxbc::Src::LU(0), dxbc::Src::LF(0.5f),
-                   dxbc::Src::R(eM));
+          a_.OpBFI(dxbc::Dest::R(round_bias_temp), dxbc::Src::LU(31), dxbc::Src::LU(0),
+                   dxbc::Src::LF(0.5f), dxbc::Src::R(eM));
           a_.OpAdd(dxbc::Dest::R(eM), dxbc::Src::R(eM), dxbc::Src::R(round_bias_temp));
           a_.OpFToI(dxbc::Dest::R(eM), dxbc::Src::R(eM));
         }
