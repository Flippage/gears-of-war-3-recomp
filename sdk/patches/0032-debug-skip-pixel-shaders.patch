Diagnostics for Gears of War 3: debug_skip_ps lists pixel shader hashes (as printed by the
GOW2_DEV_TOOLS DRAW trace) whose draws are skipped, to find which pass draws an artifact.

--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -43,6 +43,11 @@
 
 REXCVAR_DEFINE_BOOL(d3d12_bindless, true, "GPU/D3D12", "Use bindless resources where available")
     .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+REXCVAR_DEFINE_STRING(debug_skip_ps, "", "GPU/Debug",
+                      "Comma-separated 16-digit pixel shader hashes (as in the DRAW trace lines) whose "
+                      "draws are skipped. A diagnostic: empty by default.")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
 REXCVAR_DEFINE_BOOL(d3d12_readback_memexport, false, "GPU/D3D12",
                     "Read data written by memory export in shaders on the CPU")
@@ -2392,6 +2397,30 @@
   bool memexport_used = memexport_used_vertex || memexport_used_pixel;
 
   if (pixel_shader) {
+    // debug_skip_ps: drop the draws of the listed pixel shaders (diagnostics).
+    static std::string skip_text;
+    static std::vector<uint64_t> skip_hashes;
+    const std::string& want = REXCVAR_GET(debug_skip_ps);
+    if (want != skip_text) {
+      skip_text = want;
+      skip_hashes.clear();
+      size_t pos = 0;
+      while (pos < want.size()) {
+        size_t end = want.find(',', pos);
+        if (end == std::string::npos) end = want.size();
+        std::string item = want.substr(pos, end - pos);
+        if (!item.empty()) skip_hashes.push_back(std::strtoull(item.c_str(), nullptr, 16));
+        pos = end + 1;
+      }
+    }
+    if (!skip_hashes.empty() &&
+        std::find(skip_hashes.begin(), skip_hashes.end(), pixel_shader->ucode_data_hash()) !=
+            skip_hashes.end()) {
+      return true;
+    }
+  }
+
+  if (pixel_shader) {
     gow2::NoteSceneDraw(
         reinterpret_cast<const float*>(&regs.values[XE_GPU_REG_SHADER_CONSTANT_000_X]),
         uint32_t(regs.Get<reg::RB_COLOR_INFO>().color_format), index_count);
