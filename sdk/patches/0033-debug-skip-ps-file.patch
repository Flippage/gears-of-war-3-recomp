Diagnostics for Gears of War 3: debug_skip_ps also reads debug_skip_ps.txt in the working
directory (checked about once a second), so the list can change while the game runs.

--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -12,6 +12,9 @@
 #include "performance_stats.h"
 
 #include <algorithm>
+#include <cstdio>
+#include <cctype>
+#include <chrono>
 #include <cstdarg>
 #include <cstring>
 #include <sstream>
@@ -2400,7 +2403,26 @@
     // debug_skip_ps: drop the draws of the listed pixel shaders (diagnostics).
     static std::string skip_text;
     static std::vector<uint64_t> skip_hashes;
-    const std::string& want = REXCVAR_GET(debug_skip_ps);
+    // Also debug_skip_ps.txt in the working directory, checked about once a second, so the list can
+    // be changed while the game runs without the console.
+    static std::string file_text;
+    static auto next_check = std::chrono::steady_clock::time_point{};
+    const auto now = std::chrono::steady_clock::now();
+    if (now >= next_check) {
+      next_check = now + std::chrono::seconds(1);
+      std::string text;
+      if (FILE* f = std::fopen("debug_skip_ps.txt", "rb")) {
+        char buf[4096];
+        size_t n;
+        while ((n = std::fread(buf, 1, sizeof(buf), f)) > 0) text.append(buf, n);
+        std::fclose(f);
+      }
+      for (char& c : text) {
+        if (!std::isxdigit(static_cast<unsigned char>(c))) c = ',';
+      }
+      file_text = text;
+    }
+    const std::string want = REXCVAR_GET(debug_skip_ps) + "," + file_text;
     if (want != skip_text) {
       skip_text = want;
       skip_hashes.clear();
