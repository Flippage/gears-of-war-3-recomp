 REXCVAR_DEFINE_INT32(gow2_campos_register, 13, "gfx",
                      "VS float constant row holding the camera world position");
+REXCVAR_DEFINE_BOOL(gow2_depth_reversed, true, "gfx",
+                    "The scene depth buffer holds 1 - z (Gears of War 2); false for titles that store "
+                    "plain z, 0 at the near plane (Gears of War 3). Read when the upscaler starts");
 
