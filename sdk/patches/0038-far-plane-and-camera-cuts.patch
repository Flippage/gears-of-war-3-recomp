Gears of War 3: with plain z, cleared depth and sky sit at or past the far plane, where the motion
vector shader divided by ~0 (blocky white flashes in DLSS, mostly in cutscenes). Such pixels are
now points at infinity moved by the rotation only, and NaN/inf vectors become 0. The history is
also reset on a camera cut: a turn of more than ~20 degrees, a 5% lens change or a 300 unit jump
in one frame.

--- a/src/graphics/d3d12/gow2_upscale.cpp
+++ b/src/graphics/d3d12/gow2_upscale.cpp
@@ -63,14 +63,21 @@
   float z = reversed > 0.5 ? 1.0 - d : d;
   float2 ndc = float2((id.x + 0.5) / size.x * 2.0 - 1.0, 1.0 - (id.y + 0.5) / size.y * 2.0);
   float4 q = mul(float4(ndc, z, 1.0), invVP);
-  float3 p = q.xyz / q.w;
-  float4 cp = mul(float4(p + tdelta, 1.0), prevVP);
+  float4 cp;
+  if (q.w <= 1e-6 * max(length(q.xyz), 1e-20)) {
+    // At or past the far plane (cleared depth, sky): a point at infinity in direction q.xyz, which
+    // only the camera rotation moves. Dividing by q.w here gave garbage vectors.
+    cp = mul(float4(q.xyz, 0.0), prevVP);
+  } else {
+    cp = mul(float4(q.xyz / q.w + tdelta, 1.0), prevVP);
+  }
   float2 mv = float2(0.0, 0.0);
   if (cp.w > 1e-4) {
     float2 pn = cp.xy / cp.w;
     float2 ppx = float2((pn.x * 0.5 + 0.5) * size.x, (0.5 - pn.y * 0.5) * size.y);
     mv = ppx - (float2(id.xy) + 0.5);
   }
+  if (any(isnan(mv)) || any(isinf(mv))) mv = float2(0.0, 0.0);
   mvOut[id.xy] = mv;
 }
 )";
