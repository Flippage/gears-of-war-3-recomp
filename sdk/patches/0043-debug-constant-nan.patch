             float_constants,
             &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + (i << 8) + (float_constant_index << 2)],
             4 * sizeof(float));
+        CheckFloatConstant(reinterpret_cast<float*>(float_constants), 'V',
+                           vertex_shader->ucode_data_hash(), (i << 6) + float_constant_index);
         float_constants += 4 * sizeof(float);
       }
