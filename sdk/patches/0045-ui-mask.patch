+void NoteUiDraw(const RegisterFile& regs, const memory::Memory& memory,
+                const Shader& vertex_shader, uint32_t ps_texture_mask, uint32_t index_count) {
+  if (!Enabled() || !REXCVAR_GET(gow2_ui_mask)) return;
+  const uint32_t fw = g_state.color_resolve_w ? g_state.color_resolve_w : g_state.guest_w;
+  const uint32_t fh = g_state.color_resolve_h ? g_state.color_resolve_h : g_state.guest_h;
+  if (!fw || !fh) return;
+
+  bool samples_scene_color = false;
+  for (uint32_t i = 0; i < 32 && g_state.full_color_dst_count && !samples_scene_color; ++i) {
+    if (!(ps_texture_mask & (1u << i))) continue;
+    const uint32_t base = uint32_t(regs.GetTextureFetch(i).base_address) << 12;
+    for (uint32_t k = 0; k < g_state.full_color_dst_count; ++k)
+      samples_scene_color |= base == g_state.full_color_dsts[k];
+  }
+  if (!samples_scene_color && !g_state.in_ui) return;
+
+  // The tonemap test runs the cheap checks first: many scene draws (glass, water, distortion)
+  // also sample the scene colour, and running their vertex shaders on the CPU cost seconds a frame.
+  bool tonemap_candidate = false;
+  if (samples_scene_color && index_count <= 12 &&
+      regs.Get<reg::RB_SURFACE_INFO>().surface_pitch == g_state.color_resolve_w) {
+    const float* vs_consts =
+        reinterpret_cast<const float*>(&regs.values[XE_GPU_REG_SHADER_CONSTANT_000_X]);
+    tonemap_candidate = FindCameraMatrix(vs_consts) < 0;
+  }
+  if (!tonemap_candidate && !g_state.in_ui) return;
+  if (!tonemap_candidate && g_state.ui_rects_overflow) return;
+
+  // UI draws are a few small draws: a big one, or more than kMaxEstimatedDraws in a frame (a
+  // false tonemap match before the last scene resolve), counts as the whole frame instead of
+  // being simulated vertex by vertex.
+  constexpr uint32_t kMaxEstimatedIndices = 1536;
+  constexpr uint32_t kMaxEstimatedDraws = 64;
+  static uint32_t estimate_frame = ~0u, estimates = 0;
+  if (estimate_frame != g_state.frame) {
+    estimate_frame = g_state.frame;
+    estimates = 0;
+  }
+  uint32_t vx0 = 0, vy0 = 0, vx1 = 0, vy1 = 0;
+  bool have_bounds = false;
+  if (index_count <= kMaxEstimatedIndices && estimates < kMaxEstimatedDraws) {
+    ++estimates;
+    DrawExtentEstimator estimator(regs, memory);
+    have_bounds = estimator.EstimateVertexBounds(vertex_shader, vx0, vy0, vx1, vy1);
+  }
+
+  if (tonemap_candidate) {
+    const bool full_screen =
+        !have_bounds || ((vx1 > vx0 && (vx1 - vx0) * 2 >= fw) &&
+                         (vy1 > vy0 && (vy1 - vy0) * 2 >= fh));
+    static int candidates_logged = 0;
+    if (candidates_logged < 6) {
+      ++candidates_logged;
+      REXGPU_WARN("GOW2 upscale: tonemap candidate n={} bounds={} ({}, {})..({}, {}) frame {}x{} -> {}",
+                  index_count, have_bounds, vx0, vy0, vx1, vy1, fw, fh,
+                  full_screen ? "UI phase starts" : "not full screen");
+    }
+    if (full_screen) {
+      g_state.in_ui = true;
+      g_state.ui_rect_count = 0;
+      g_state.ui_rects_overflow = false;
+      return;
+    }
+  }
+
+  if (!g_state.in_ui || g_state.ui_rects_overflow) return;
+
+  uint32_t x0 = 0, y0 = 0, x1 = fw, y1 = fh;
+  if (have_bounds) {
+    constexpr uint32_t kPad = 2;
+    x0 = std::min(fw, vx0 > kPad ? vx0 - kPad : 0u);
+    y0 = std::min(fh, vy0 > kPad ? vy0 - kPad : 0u);
+    x1 = std::min(fw, vx1 + kPad);
+    y1 = std::min(fh, vy1 + kPad);
+    if (x0 >= x1 || y0 >= y1) return;
+  }
+
+  if (g_state.ui_rect_count < kMaxUiRects) {
+    g_state.ui_rects[g_state.ui_rect_count++] = {
+        uint16_t(x0), uint16_t(y0), uint16_t(x1), uint16_t(y1)};
+  } else {
+    g_state.ui_rects[0] = {0, 0, uint16_t(fw), uint16_t(fh)};
+    g_state.ui_rect_count = 1;
+    g_state.ui_rects_overflow = true;
+  }
+}
+
 }  // namespace rex::graphics::d3d12::gow2
