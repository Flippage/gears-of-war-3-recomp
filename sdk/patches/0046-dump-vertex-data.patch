+void DumpVertexData(const RegisterFile& regs, const memory::Memory& memory, const Shader& vertex_shader) {
+  if (!g_dump_this_frame) return;
+  const std::string list = REXCVAR_GET(gow2_dump_vs);
+  if (list.empty()) return;
+  const uint64_t hash = vertex_shader.ucode_data_hash();
+  char hex[24];
+  std::snprintf(hex, sizeof hex, "%016llX", static_cast<unsigned long long>(hash));
+  if (list.find(hex) == std::string::npos) return;
+  static uint32_t seq_seen = ~0u;
+  static std::vector<uint64_t> done;  // shader hashes and buffer addresses already written this dump
+  if (seq_seen != g_dump_seq) {
+    seq_seen = g_dump_seq;
+    done.clear();
+  }
+  auto first_time = [](uint64_t key) {
+    if (std::find(done.begin(), done.end(), key) != done.end()) return false;
+    done.push_back(key);
+    return true;
+  };
+  char name[128];
+  if (first_time(hash)) {
+    std::snprintf(name, sizeof name, "gow2_dump/f%u_vs%s.txt", g_dump_seq, hex);
+    if (FILE* f = std::fopen(name, "wb")) {
+      std::fwrite(vertex_shader.ucode_disassembly().data(), 1, vertex_shader.ucode_disassembly().size(), f);
+      std::fclose(f);
+    }
+  }
+  std::snprintf(name, sizeof name, "gow2_dump/f%u_vbindex.txt", g_dump_seq);
+  FILE* index = std::fopen(name, "ab");
+  for (const auto& b : vertex_shader.vertex_bindings()) {
+    xenos::xe_gpu_vertex_fetch_t vf = regs.GetVertexFetch(b.fetch_constant);
+    const uint32_t address = uint32_t(vf.address) << 2, size = uint32_t(vf.size) << 2;
+    if (index) {
+      std::fprintf(index, "vs=%s vb%u addr=%08X size=%u stride=%u", hex, b.fetch_constant, address,
+                   size, b.stride_words);
+      for (const auto& a : b.attributes) {
+        const auto& at = a.fetch_instr.attributes;
+        std::fprintf(index, " [fmt=%u off=%d signed=%d int=%d exp=%d]", uint32_t(at.data_format),
+                     at.offset, int(at.is_signed), int(at.is_integer), at.exp_adjust);
+      }
+      std::fprintf(index, "\n");
+    }
+    if (!size || size > (64u << 20) || !first_time(0x100000000ull | address)) continue;
+    std::snprintf(name, sizeof name, "gow2_dump/f%u_vb%08X.bin", g_dump_seq, address);
+    if (FILE* f = std::fopen(name, "wb")) {
+      std::fwrite(memory.TranslatePhysical<const uint8_t*>(address), 1, size, f);
+      std::fclose(f);
+    }
+  }
+  if (index) std::fclose(index);
+}
+
 }  // namespace rex::graphics::d3d12::gow2
