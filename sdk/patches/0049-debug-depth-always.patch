Gears of War 3 diagnostics: debug_depth_always.txt lists pixel shader hashes whose draws get their
depth test forced to "always" for that draw (shows whether a pass is lost to depth rejection), and the
-Dev DRAW trace also prints the depth test, function, write flag and polygon offset of each draw.

--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -2473,6 +2473,50 @@
     }
   }
 
+  // debug_depth_always.txt (working directory, read about once a second): pixel shader hashes whose
+  // draws get their depth test forced to "always" for that draw only (diagnostics: shows whether a
+  // pass is being lost to depth rejection). Restored when the draw is done.
+  struct DepthControlRestore {
+    RegisterFile* register_file;
+    uint32_t value = 0;
+    bool active = false;
+    ~DepthControlRestore() {
+      if (active) register_file->values[XE_GPU_REG_RB_DEPTHCONTROL] = value;
+    }
+  } depth_control_restore{register_file_};
+  if (pixel_shader) {
+    static std::vector<uint64_t> always_hashes;
+    static auto next_check = std::chrono::steady_clock::time_point{};
+    const auto now = std::chrono::steady_clock::now();
+    if (now >= next_check) {
+      next_check = now + std::chrono::seconds(1);
+      always_hashes.clear();
+      if (FILE* f = std::fopen("debug_depth_always.txt", "rb")) {
+        std::string text;
+        char buf[4096];
+        size_t n;
+        while ((n = std::fread(buf, 1, sizeof(buf), f)) > 0) text.append(buf, n);
+        std::fclose(f);
+        size_t pos = 0;
+        while (pos < text.size()) {
+          while (pos < text.size() && !std::isxdigit(static_cast<unsigned char>(text[pos]))) ++pos;
+          size_t end = pos;
+          while (end < text.size() && std::isxdigit(static_cast<unsigned char>(text[end]))) ++end;
+          if (end > pos) always_hashes.push_back(std::strtoull(text.substr(pos, end - pos).c_str(), nullptr, 16));
+          pos = end;
+        }
+      }
+    }
+    if (std::find(always_hashes.begin(), always_hashes.end(), pixel_shader->ucode_data_hash()) !=
+        always_hashes.end()) {
+      depth_control_restore.value = register_file_->values[XE_GPU_REG_RB_DEPTHCONTROL];
+      depth_control_restore.active = true;
+      auto depth_control = regs.Get<reg::RB_DEPTHCONTROL>();
+      depth_control.zfunc = xenos::CompareFunction::kAlways;
+      register_file_->values[XE_GPU_REG_RB_DEPTHCONTROL] = depth_control.value;
+    }
+  }
+
