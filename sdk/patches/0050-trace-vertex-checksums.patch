Gears of War 3 diagnostics (-Dev builds): the DRAW trace also prints a checksum of each vertex buffer's
guest contents (up to 1 MB) as the draw is processed, to see whether the CPU rewrites a buffer between
two draws of the same frame (face morph data between the base and lighting passes).

--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -2546,6 +2546,15 @@
       xenos::xe_gpu_vertex_fetch_t vf = regs.GetVertexFetch(b.fetch_constant);
       vb += fmt::format(" vb{}={:08X}/{}/s{}", b.fetch_constant, uint32_t(vf.address) << 2,
                         uint32_t(vf.size) << 2, b.stride_words);
+      // Checksum of the buffer's guest contents as this draw is processed (FNV-1a, buffers up to
+      // 1 MB), to see whether the CPU rewrote it between two draws of the same frame.
+      const uint32_t vb_size = uint32_t(vf.size) << 2;
+      if (vb_size && vb_size <= (1u << 20)) {
+        const uint8_t* p = memory_->TranslatePhysical<const uint8_t*>(uint32_t(vf.address) << 2);
+        uint32_t h = 2166136261u;
+        for (uint32_t i = 0; i < vb_size; ++i) h = (h ^ p[i]) * 16777619u;
+        vb += fmt::format("#{:08X}", h);
+      }
     }
     if (index_buffer_info) vb += fmt::format(" ib={:08X}", index_buffer_info->guest_base);
     {
