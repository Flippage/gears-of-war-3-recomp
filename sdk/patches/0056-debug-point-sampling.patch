Gears of War 3 diagnostics (-Dev and release): debug_point_ps.txt in the working directory (read about
once a second) lists pixel shader hashes whose draws sample every texture with point filtering and no
anisotropy. For the speckled final post-process pass at 2x/3x internal resolution, which decodes a
packed HDR scene colour with floor/frac and breaks when neighbouring texels are blended.

diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 0d5755e..2fa46e1 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -81,6 +81,39 @@ void CheckFloatConstant(float* c, char stage, uint64_t shader_hash, uint32_t reg
       if (!std::isfinite(c[k])) c[k] = 0.0f;
   }
 }
+
+// debug_point_ps.txt (working directory, read about once a second): pixel shader hashes whose
+// draws sample every texture with point filtering and no anisotropy (diagnostics, for passes that
+// decode packed values from a texture and break when neighbouring texels are blended).
+bool DebugPointSampling(uint64_t pixel_shader_hash) {
+  static std::vector<uint64_t> hashes;
+  static auto next_check = std::chrono::steady_clock::time_point{};
+  const auto now = std::chrono::steady_clock::now();
+  if (now >= next_check) {
+    next_check = now + std::chrono::seconds(1);
+    std::string text;
+    if (FILE* f = std::fopen("debug_point_ps.txt", "rb")) {
+      char buf[4096];
+      size_t n;
+      while ((n = std::fread(buf, 1, sizeof(buf), f)) > 0) text.append(buf, n);
+      std::fclose(f);
+    }
+    for (char& c : text) {
+      if (!std::isxdigit(static_cast<unsigned char>(c))) c = ',';
+    }
+    hashes.clear();
+    size_t pos = 0;
+    while (pos < text.size()) {
+      size_t end = text.find(',', pos);
+      if (end == std::string::npos) end = text.size();
+      std::string item = text.substr(pos, end - pos);
+      if (!item.empty()) hashes.push_back(std::strtoull(item.c_str(), nullptr, 16));
+      pos = end + 1;
+    }
+  }
+  return !hashes.empty() &&
+         std::find(hashes.begin(), hashes.end(), pixel_shader_hash) != hashes.end();
+}
