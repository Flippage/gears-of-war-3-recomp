+  // Gears of War 3 recomp: gpu_guest_pixel_center_ps. With resolution scaling,
+  // move the interpolants of the listed pixel shaders from the host pixel centre
+  // to the centre of its guest pixel (v + ddx(v) * dx + ddy(v) * dy, exact for
+  // the affine interpolants of full-screen passes), so every host pixel computes
+  // what the guest pixel computes at 1x. For passes that build tables from their
+  // coordinates; with gpu_unscaled_resolve_max_pitch the table is then read at 1x.
+  if ((draw_resolution_scale_x_ > 1 || draw_resolution_scale_y_ > 1) &&
+      !uses_register_dynamic_addressing && interpolator_mask) {
+    bool guest_pixel_center = false;
+    const std::string list = REXCVAR_GET(gpu_guest_pixel_center_ps);
+    size_t pos = 0;
+    while (pos < list.size() && !guest_pixel_center) {
+      size_t end = list.find(',', pos);
+      if (end == std::string::npos) end = list.size();
+      std::string item = list.substr(pos, end - pos);
+      if (!item.empty() &&
+          std::strtoull(item.c_str(), nullptr, 16) == current_shader().ucode_data_hash()) {
+        guest_pixel_center = true;
+      }
+      pos = end + 1;
+    }
+    if (guest_pixel_center) {
+      uint32_t offset_temp = PushSystemTemp();
+      uint32_t derivative_temp = PushSystemTemp();
+      float scale_x = float(draw_resolution_scale_x_);
+      float scale_y = float(draw_resolution_scale_y_);
+      in_position_used_ |= 0b0011;
+      // offset_temp.xy = host pixel index
+      a_.OpRoundNI(dxbc::Dest::R(offset_temp, 0b0011), dxbc::Src::V1D(in_reg_ps_position_));
+      // offset_temp.zw = guest pixel index
+      a_.OpMAd(dxbc::Dest::R(offset_temp, 0b1100), dxbc::Src::R(offset_temp, 0b01000100),
+               dxbc::Src::LF(0.0f, 0.0f, 1.0f / scale_x, 1.0f / scale_y),
+               dxbc::Src::LF(0.0f, 0.0f, 0.5f / scale_x, 0.5f / scale_y));
+      a_.OpRoundNI(dxbc::Dest::R(offset_temp, 0b1100), dxbc::Src::R(offset_temp));
+      // offset_temp.zw = guest pixel centre in host pixels, relative to the
+      // host pixel index
+      a_.OpMAd(dxbc::Dest::R(offset_temp, 0b1100), dxbc::Src::R(offset_temp),
+               dxbc::Src::LF(0.0f, 0.0f, scale_x, scale_y),
+               dxbc::Src::LF(0.0f, 0.0f, 0.5f * scale_x - 0.5f, 0.5f * scale_y - 0.5f));
+      // offset_temp.xy = offset from the host pixel centre to the guest pixel
+      // centre, in host pixels
+      a_.OpAdd(dxbc::Dest::R(offset_temp, 0b0011), dxbc::Src::R(offset_temp, 0b1110),
+               -dxbc::Src::R(offset_temp, 0b0100));
+      uint32_t derivative_y_temp = PushSystemTemp();
+      for (uint32_t i = 0; i < register_count() && i < xenos::kMaxInterpolators; ++i) {
+        if (i == param_gen_interpolator || !(interpolator_mask & (UINT32_C(1) << i))) {
+          continue;
+        }
+        a_.OpDerivRTXFine(dxbc::Dest::R(derivative_temp), dxbc::Src::R(i));
+        a_.OpDerivRTYFine(dxbc::Dest::R(derivative_y_temp), dxbc::Src::R(i));
+        a_.OpMAd(dxbc::Dest::R(i), dxbc::Src::R(derivative_temp),
+                 dxbc::Src::R(offset_temp, dxbc::Src::kXXXX), dxbc::Src::R(i));
+        a_.OpMAd(dxbc::Dest::R(i), dxbc::Src::R(derivative_y_temp),
+                 dxbc::Src::R(offset_temp, dxbc::Src::kYYYY), dxbc::Src::R(i));
+      }
+      // Release derivative_y_temp, derivative_temp and offset_temp.
+      PopSystemTemp(3);
+    }
+  }
+
