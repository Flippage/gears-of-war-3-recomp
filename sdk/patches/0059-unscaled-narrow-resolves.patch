diff --git a/src/graphics/shaders/resolve_downscale_units.cs.hlsl b/src/graphics/shaders/resolve_downscale_units.cs.hlsl
new file mode 100644
index 0000000..87f656d
--- /dev/null
+++ b/src/graphics/shaders/resolve_downscale_units.cs.hlsl
@@ -0,0 +1,45 @@
+// Gears of War 3 recomp: downscales a resolution-scaled resolve destination back to 1x, element by
+// element, following the scaled layout the resolve shaders write (XeTextureScaledTiledOffset in
+// Xenia's texture_address.xesli): every guest unit of N consecutive blocks (N * bpb = 16 bytes for
+// 4 and 8 bytes per block) at guest address U is stored at U * scale_x * scale_y as scale_x by
+// scale_y host sub-units of N blocks, column-major. The top-left host pixel of each guest pixel is
+// taken. Used for narrow resolves (gpu_unscaled_resolve_max_pitch) whose textures are read at 1x.
+// Same root signature and constants as resolve_downscale.cs.hlsl.
+
+cbuffer XeResolveDownscaleConstants : register(b0) {
+  uint xe_downscale_scale_x;
+  uint xe_downscale_scale_y;
+  uint xe_downscale_bpb_log2;     // 2 (32bpp) or 3 (64bpp)
+  uint xe_downscale_block_count;  // Number of 1x blocks to write
+  uint xe_downscale_unused;
+};
+
+ByteAddressBuffer xe_resolve_source : register(t0);   // Scaled data of the range
+RWByteAddressBuffer xe_resolve_dest : register(u0);   // 1x data of the range
+
+[numthreads(64, 1, 1)]
+void main(uint3 xe_thread_id : SV_DispatchThreadID) {
+  uint block = xe_thread_id.x;
+  [branch] if (block >= xe_downscale_block_count) {
+    return;
+  }
+  uint bpb_log2 = xe_downscale_bpb_log2;
+  // Blocks per unit: 4 at 4 bytes per block, 2 at 8 (16-byte units).
+  uint unit_blocks_log2 = 4u - bpb_log2;
+  uint offset = block << bpb_log2;
+  uint unit_offset = offset & ~((1u << (unit_blocks_log2 + bpb_log2)) - 1u);
+  uint block_in_unit = block & ((1u << unit_blocks_log2) - 1u);
+  // Top-left host pixel of the guest block, and the host sub-unit it is in.
+  uint host_x = block_in_unit * xe_downscale_scale_x;
+  uint sub_unit_x = host_x >> unit_blocks_log2;
+  uint host_x_in_sub_unit = host_x & ((1u << unit_blocks_log2) - 1u);
+  uint source =
+      unit_offset * (xe_downscale_scale_x * xe_downscale_scale_y) +
+      ((((sub_unit_x * xe_downscale_scale_y) << unit_blocks_log2) + host_x_in_sub_unit)
+       << bpb_log2);
+  [branch] if (bpb_log2 == 3u) {
+    xe_resolve_dest.Store2(offset, xe_resolve_source.Load2(source));
+  } else {
+    xe_resolve_dest.Store(offset, xe_resolve_source.Load(source));
+  }
+}
