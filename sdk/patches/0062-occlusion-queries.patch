+namespace {
+// Occlusion query outcome counts, logged every 5 seconds (OCCLUSION): query ends answered by the
+// host (and how many of them were zero, occluded), ends given the fake "visible" count, and
+// packets handled while host queries are off.
+enum class OcclusionOutcome { kHost, kFake, kOff };
+struct OcclusionStats {
+  uint64_t host = 0, zero = 0, fake = 0, off = 0;
+  std::chrono::steady_clock::time_point window = std::chrono::steady_clock::now();
+};
+OcclusionStats g_occlusion_stats;
+void NoteOcclusion(OcclusionOutcome outcome, uint64_t samples = 0) {
+  OcclusionStats& st = g_occlusion_stats;
+  switch (outcome) {
+    case OcclusionOutcome::kHost:
+      ++st.host;
+      if (!samples) ++st.zero;
+      break;
+    case OcclusionOutcome::kFake:
+      ++st.fake;
+      break;
+    case OcclusionOutcome::kOff:
+      ++st.off;
+      break;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if (now - st.window >= std::chrono::seconds(5)) {
+    REXGPU_INFO("OCCLUSION host_results={} occluded={} fake_visible={} packets_with_queries_off={}",
+                st.host, st.zero, st.fake, st.off);
+    st = OcclusionStats{};
+    st.window = now;
+  }
+}
