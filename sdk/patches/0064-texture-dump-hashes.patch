+// Whether `hash` is in the comma-separated hex list of texture_dump_hashes.
+bool InDumpHashList(uint64_t hash, const std::string& list) {
+  const char* p = list.c_str();
+  while (*p) {
+    while (*p == ' ' || *p == ',') ++p;
+    if (!*p) break;
+    char* end = nullptr;
+    const uint64_t value = std::strtoull(p, &end, 16);
+    if (end == p) {
+      ++p;
+      continue;
+    }
+    if (value == hash) return true;
+    p = end;
+  }
+  return false;
+}
