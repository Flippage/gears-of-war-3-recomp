+uint64_t InputSystem::GetLastPhysicalControllerActivity(int* out_gamepad_type) const {
+  uint64_t latest_time = 0;
+  int latest_type = 0;
+  for (const auto& driver : drivers_) {
+    int type = 0;
+    uint64_t t = driver->GetLastPhysicalActivity(&type);
+    if (t > latest_time) {
+      latest_time = t;
+      latest_type = type;
+    }
+  }
+  if (out_gamepad_type) {
+    *out_gamepad_type = latest_type;
+  }
+  return latest_time;
+}
