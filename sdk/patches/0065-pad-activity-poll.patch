+  /// controller's SDL_GamepadType or 0. Synthetic drivers return 0.
+  virtual uint64_t GetLastPhysicalActivity(int* out_type) const {
+    if (out_type) {
+      *out_type = 0;
+    }
+    return 0;
+  }
