 std::unique_ptr<InputSystem> CreateDefaultInputSystem(bool tool_mode) {
   auto input = std::make_unique<InputSystem>(nullptr);
 
@@ -385,3 +403,16 @@ std::unique_ptr<InputSystem> CreateDefaultInputSystem(bool tool_mode) {
 }
 
 }  // namespace rex::input
+ 
+extern "C" __declspec(dllexport) uint64_t rex_input_get_last_physical_activity(int* out_type) {
+  auto* rt = rex::Runtime::instance();
+  if (!rt || !rt->input_system()) {
+    if (out_type) {
+      *out_type = 0;
+    }
+    return 0;
+  }
+  auto* input_sys = static_cast<rex::input::InputSystem*>(rt->input_system());
+  return input_sys->GetLastPhysicalControllerActivity(out_type);
+}
