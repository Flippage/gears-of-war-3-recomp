diff --git a/src/system/shader_progress.cpp b/src/system/shader_progress.cpp
new file mode 100644
index 0000000..d6e3a06
--- /dev/null
+++ b/src/system/shader_progress.cpp
@@ -0,0 +1,56 @@
+// Gears of War 3 recomp: startup shader loading progress, see rex/shader_progress.h.
+
+#include <rex/shader_progress.h>
+
+#include <atomic>
+
+namespace rex {
+
+namespace {
+std::atomic<bool> g_active{false};
+std::atomic<uint32_t> g_done{0};
+std::atomic<uint32_t> g_total{0};
+}  // namespace
+
+void SetShaderLoadingActive(bool active) {
+  if (active) {
+    g_done.store(0, std::memory_order_relaxed);
+    g_total.store(0, std::memory_order_relaxed);
+  }
+  g_active.store(active, std::memory_order_release);
+}
+
+void SetShaderLoadingTotal(uint32_t total) {
+  g_done.store(0, std::memory_order_relaxed);
+  g_total.store(total, std::memory_order_release);
+}
+
+void AdvanceShaderLoading() {
+  if (g_active.load(std::memory_order_acquire)) {
+    g_done.fetch_add(1, std::memory_order_acq_rel);
+  }
+}
+
+ShaderLoadingProgress GetShaderLoadingProgress() {
+  ShaderLoadingProgress p;
+  p.active = g_active.load(std::memory_order_acquire);
+  p.total = g_total.load(std::memory_order_acquire);
+  p.done = g_done.load(std::memory_order_acquire);
+  if (p.done > p.total) p.done = p.total;
+  return p;
+}
+
+}  // namespace rex
+
+// For the host application: games compile ReXApp (share/rexglue/rex_app.cpp) into their own exe
+// against the SDK headers, so they reach these counters by name (GetProcAddress) instead.
+extern "C" __declspec(dllexport) void rex_shader_loading_set_active(bool active) {
+  rex::SetShaderLoadingActive(active);
+}
+
+extern "C" __declspec(dllexport) bool rex_shader_loading_get(uint32_t* done, uint32_t* total) {
+  const rex::ShaderLoadingProgress p = rex::GetShaderLoadingProgress();
+  if (done) *done = p.done;
+  if (total) *total = p.total;
+  return p.active;
+}
