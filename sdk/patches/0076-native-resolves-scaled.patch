Native resolves scaled: resolution scaling support for native resolves, writing into scaled destination host textures at matching resolution scale. Vulkan and GLSL portions skipped. Ported from Gears of War 2 port patch 0041 by santiquiroz.

diff --git a/include/rex/graphics/d3d12/texture_cache.h b/include/rex/graphics/d3d12/texture_cache.h
index c1e1f33..69e4e1e 100644
--- a/include/rex/graphics/d3d12/texture_cache.h
+++ b/include/rex/graphics/d3d12/texture_cache.h
@@ -204,6 +204,11 @@ class D3D12TextureCache final : public TextureCache {
     NativeResolveMode mode = NativeResolveMode::kCopy;
     // kScale multiplier.
     float scale = 1.0f;
+    // Shader modes: resolution-scaled host pixel columns / rows at the left / top of the rectangle
+    // taken from the first column / row after them - the half-pixel offset gap fill of the resolve
+    // shaders (ResolveEdramInfo::fill_half_pixel_offset).
+    uint32_t fill_x = 0;
+    uint32_t fill_y = 0;
     // Shader modes: the non-shader-visible SRV of the source to copy if source_srv_format is
     // DXGI_FORMAT_UNKNOWN, otherwise a 2D source SRV with source_srv_format is created.
     D3D12_CPU_DESCRIPTOR_HANDLE source_srv = {};
@@ -610,6 +615,7 @@ class D3D12TextureCache final : public TextureCache {
     int32_t source_offset[2];
     int32_t dest_offset[2];
     uint32_t size[2];
+    uint32_t fill[2];
   };
   Microsoft::WRL::ComPtr<ID3D12RootSignature> native_resolve_root_signature_;
   Microsoft::WRL::ComPtr<ID3D12PipelineState> native_resolve_pipeline_;
diff --git a/src/graphics/d3d12/render_target_cache.cpp b/src/graphics/d3d12/render_target_cache.cpp
