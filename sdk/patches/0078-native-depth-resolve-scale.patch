Native depth resolve scale: doubles depth coordinate scale for D24FS8 native resolves so the full 0..1 floating point range is properly sampled and preserved. Vulkan and GLSL portions skipped. Ported from Gears of War 2 port patch 0043 by santiquiroz.

diff --git a/src/graphics/d3d12/render_target_cache.cpp b/src/graphics/d3d12/render_target_cache.cpp
index 8ecb4a6..c74f225 100644
--- a/src/graphics/d3d12/render_target_cache.cpp
+++ b/src/graphics/d3d12/render_target_cache.cpp
@@ -6131,6 +6131,8 @@ void D3D12RenderTargetCache::WriteResolveToTextures(const draw_util::ResolveInfo
     } else if (source_format == xenos::DepthRenderTargetFormat::kD24FS8) {
       pair = NativeResolvePair::kD24FS8;
       texture_format = xenos::TextureFormat::k_24_8_FLOAT;
+      // The host keeps guest float24 depth [0, 2) as [0, 1).
+      write.scale = 2.0f;
     } else {
       fallback(NativeResolveFallback::kDepth);
       return;
