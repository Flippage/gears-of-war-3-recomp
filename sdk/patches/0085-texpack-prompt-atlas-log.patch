+namespace {
+// Gears of War 3: what happens to textures of the button prompt atlases' size and format (512x512
+// and 256x256 DXT4/5) when they are loaded, to see why a replacement is not applied (capped).
+void LogPromptSizedTexture(xenos::TextureFormat format, uint32_t w, uint32_t h,
+                           uint32_t base_address, const char* what, uint64_t hash) {
+  static std::atomic<int> count{0};
+  if (format != xenos::TextureFormat::k_DXT4_5) {
+    return;
+  }
+  if (!((w == 512 && h == 512) || (w == 256 && h == 256))) {
+    return;
+  }
+  if (count.fetch_add(1) >= 400) {
+    return;
+  }
+  REXLOG_INFO("[texpack] {}x{} at {:08X}: {} (hash {:016x})", w, h, base_address, what, hash);
+}
+}  // namespace
