+namespace {
+// Runs for every draw until the pass is found: the list is parsed again only when it changes.
+bool IsHudFinalPass(uint64_t ps_hash) {
+  static std::string parsed_list;
+  static std::vector<uint64_t> hashes;
+  const std::string& list = REXCVAR_GET(gow2_hud_final_ps);
+  if (list != parsed_list) {
+    parsed_list = list;
+    hashes.clear();
+    size_t pos = 0;
+    while (pos < list.size()) {
+      size_t end = list.find(',', pos);
+      if (end == std::string::npos) end = list.size();
+      const std::string item = list.substr(pos, end - pos);
+      if (!item.empty()) hashes.push_back(std::strtoull(item.c_str(), nullptr, 16));
+      pos = end + 1;
+    }
+  }
+  return std::find(hashes.begin(), hashes.end(), ps_hash) != hashes.end();
+}
+}  // namespace
