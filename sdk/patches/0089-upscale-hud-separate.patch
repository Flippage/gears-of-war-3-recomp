+bool D3D12RenderTargetCache::GetLastUpdateColor0Desc(D3D12_RESOURCE_DESC* desc_out) const {
+  if (GetPath() != Path::kHostRenderTargets) {
+    return false;
+  }
+  const RenderTarget* rt = last_update_accumulated_render_targets()[1];
+  if (!rt) {
+    return false;
+  }
+  *desc_out = static_cast<const D3D12RenderTarget*>(rt)->resource()->GetDesc();
+  return true;
+}
+
+bool D3D12RenderTargetCache::CopyLastUpdateColor0(ID3D12Resource* dest,
+                                                  D3D12_RESOURCE_STATES dest_state,
+                                                  uint32_t width, uint32_t height) {
+  if (GetPath() != Path::kHostRenderTargets) {
+    return false;
+  }
+  RenderTarget* rt = last_update_accumulated_render_targets()[1];
+  if (!rt || !dest) {
+    return false;
+  }
+  auto& d3d12_rt = *static_cast<D3D12RenderTarget*>(rt);
+  ID3D12Resource* source = d3d12_rt.resource();
+  const D3D12_RESOURCE_DESC source_desc = source->GetDesc();
+  if (source_desc.SampleDesc.Count != 1 || source_desc.Width < width ||
+      source_desc.Height < height) {
+    return false;
+  }
+  const D3D12_RESOURCE_STATES old_state =
+      d3d12_rt.SetResourceState(D3D12_RESOURCE_STATE_COPY_SOURCE);
+  command_processor_.PushTransitionBarrier(source, old_state, D3D12_RESOURCE_STATE_COPY_SOURCE);
+  command_processor_.PushTransitionBarrier(dest, dest_state, D3D12_RESOURCE_STATE_COPY_DEST);
+  command_processor_.SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION dest_location = {};
+  dest_location.pResource = dest;
+  dest_location.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  dest_location.SubresourceIndex = 0;
+  D3D12_TEXTURE_COPY_LOCATION source_location = {};
+  source_location.pResource = source;
+  source_location.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  source_location.SubresourceIndex = 0;
+  D3D12_BOX box = {0, 0, 0, width, height, 1};
+  command_processor_.GetDeferredCommandList().D3DCopyTextureRegion(&dest_location, 0, 0, 0,
+                                                                   &source_location, &box);
+  command_processor_.PushTransitionBarrier(dest, D3D12_RESOURCE_STATE_COPY_DEST, dest_state);
+  command_processor_.PushTransitionBarrier(source, D3D12_RESOURCE_STATE_COPY_SOURCE, old_state);
+  d3d12_rt.SetResourceState(old_state);
+  command_processor_.SubmitBarriers();
+  return true;
+}
