+void MnkInputDriver::OnMouseWheel(rex::ui::MouseEvent& e) {
+  // Not while an overlay blocks the game's input, or scrolling it would switch weapons on close.
+  if (!IsEnabled() || !has_focus_ || REXCVAR_GET(xam_input_block))
+    return;
+  std::lock_guard lock(state_mutex_);
+  // A high-resolution wheel reports parts of a notch; they add up to whole ones.
+  constexpr int32_t kNotch = rex::ui::MouseEvent::kScrollPerDetent;
+  wheel_scroll_ += e.scroll_y();
+  while (wheel_scroll_ >= kNotch || wheel_scroll_ <= -kNotch) {
+    const int8_t dir = wheel_scroll_ > 0 ? 1 : -1;
+    wheel_scroll_ -= dir * kNotch;
+    if (wheel_notches_.size() < kMaxWheelNotches) {
+      wheel_notches_.push_back(dir);
+    }
+  }
+}
