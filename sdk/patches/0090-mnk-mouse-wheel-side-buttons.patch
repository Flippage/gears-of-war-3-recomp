+// Advances the wheel playback: ends the held notch after kWheelPress, starts the next waiting one
+// after kWheelGap. Returns the d-pad button the held notch presses (0 unless cycling weapons).
+uint16_t MnkInputDriver::UpdateWheelPulse() {
+  const auto now = std::chrono::steady_clock::now();
+  if (wheel_held_ != 0) {
+    if (now < wheel_until_) {
+      return wheel_held_button_;
+    }
+    key_down_[static_cast<uint16_t>(VirtualKey::kWheelUp)] = false;
+    key_down_[static_cast<uint16_t>(VirtualKey::kWheelDown)] = false;
+    wheel_held_ = 0;
+    wheel_held_button_ = 0;
+    wheel_until_ = now + kWheelGap;
+    return 0;
+  }
+  if (now < wheel_until_ || wheel_notches_.empty()) {
+    return 0;
+  }
+  wheel_held_ = wheel_notches_.front();
+  wheel_notches_.pop_front();
+  wheel_until_ = now + kWheelPress;
+  if (REXCVAR_GET(mnk_wheel_weapon_cycle)) {
+    weapon_slot_ = (weapon_slot_ + (wheel_held_ > 0 ? 1 : 3)) % 4;
+    wheel_held_button_ = kWeaponSlotButtons[weapon_slot_];
+  } else {
+    key_down_[static_cast<uint16_t>(wheel_held_ > 0 ? VirtualKey::kWheelUp
+                                                    : VirtualKey::kWheelDown)] = true;
+  }
+  return wheel_held_button_;
+}
